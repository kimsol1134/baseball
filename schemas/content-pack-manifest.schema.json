{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diamond-soul.local/schemas/content-pack-manifest.schema.json",
  "title": "야구 못하면 또 환생함 declarative content pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "id", "title", "version", "gameVersion", "author", "content"],
  "properties": {
    "format": { "const": "DiamondSoulContentPack" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "gameVersion": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "content": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["type", "id", "path"],
        "properties": {
          "type": { "enum": ["relationship_event", "game_scenario"] },
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+$" }
        }
      }
    }
  }
}
