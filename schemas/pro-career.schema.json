{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baseball.local/schemas/pro-career.schema.json",
  "title": "야구 못하면 또 환생함 pro career snapshot",
  "type": "object",
  "required": ["proCareerID", "revision", "phase", "identity", "pitcher", "team", "entitlement", "age", "season", "week", "level", "role", "managerTrust", "fatigue", "currentStats", "careerStats", "commitment"],
  "properties": {
    "proCareerID": { "type": "string", "pattern": "^pro-" },
    "revision": { "type": "integer", "minimum": 0 },
    "phase": { "enum": ["contract_offer", "weekly_plan", "important_game", "season_review", "offseason_decision", "retirement_decision", "completed"] },
    "age": { "type": "integer", "minimum": 18, "maximum": 50 },
    "season": { "type": "integer", "minimum": 1, "maximum": 20 },
    "week": { "type": "integer", "minimum": 0, "maximum": 24 },
    "level": { "enum": ["minor", "major"] },
    "role": { "enum": ["starter", "long_relief", "setup", "closer"] },
    "managerTrust": { "type": "integer", "minimum": 0, "maximum": 100 },
    "fatigue": { "type": "integer", "minimum": 0, "maximum": 100 },
    "entitlement": { "type": "object", "required": ["productID", "status", "source", "verifiedAt"] },
    "identity": { "type": "object" },
    "pitcher": {
      "type": "object",
      "properties": {
        "stuff": { "type": "integer", "minimum": 20, "maximum": 80 },
        "command": { "type": "integer", "minimum": 20, "maximum": 80 },
        "movement": { "type": "integer", "minimum": 20, "maximum": 80 },
        "stamina": { "type": "integer", "minimum": 20, "maximum": 80 },
        "mastery": {
          "type": "object",
          "properties": {
            "stuff": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
            "command": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
            "movement": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
            "stamina": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "team": { "type": "object" },
    "currentStats": { "type": "object" },
    "careerStats": { "type": "array" },
    "injuryEvent": {
      "type": ["object", "null"],
      "properties": {
        "cause": { "const": "overload" },
        "season": { "type": "integer", "minimum": 1, "maximum": 20 },
        "week": { "type": "integer", "minimum": 1, "maximum": 24 },
        "plan": { "enum": ["develop_stuff", "develop_movement", "develop_weapon", "refine_command", "build_stamina", "recover", "earn_trust"] },
        "rawFatigue": { "type": "integer", "minimum": 0, "maximum": 100 },
        "effectiveFatigue": { "type": "integer", "minimum": 0, "maximum": 100 },
        "pitches": { "type": "integer", "minimum": 0 },
        "recoveryWeeks": { "type": "integer", "minimum": 1, "maximum": 4 },
        "careerID": { "type": ["string", "null"] },
        "revision": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "proRulesVersion": { "type": ["integer", "null"], "minimum": 1 },
    "repertoireRulesVersion": { "type": "integer", "const": 1 },
    "pitchLearningProject": {
      "type": "object",
      "required": ["pitchType", "practiceCredits", "qualityUses", "stage"],
      "properties": {
        "pitchType": { "enum": ["slider", "curveball", "changeup"] },
        "practiceCredits": { "type": "integer", "minimum": 0, "maximum": 9 },
        "qualityUses": { "type": "integer", "minimum": 0, "maximum": 2 },
        "stage": { "enum": ["grip", "bullpen", "live_trial", "completed"] }
      },
      "additionalProperties": true
    },
    "commitment": { "type": "string", "minLength": 16 }
  }
}
