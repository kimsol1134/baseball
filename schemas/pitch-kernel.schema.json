{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diamond-soul.local/schemas/pitch-kernel.schema.json",
  "title": "Pitch Kernel command parameters",
  "oneOf": [
    { "$ref": "#/$defs/preparePitchParams" },
    { "$ref": "#/$defs/submitPitchParams" }
  ],
  "$defs": {
    "rating": { "type": "integer", "minimum": 20, "maximum": 80 },
    "zone": {
      "type": "object",
      "required": ["row", "column"],
      "properties": {
        "row": { "type": "integer", "minimum": 0, "maximum": 2 },
        "column": { "type": "integer", "minimum": 0, "maximum": 2 }
      },
      "additionalProperties": false
    },
    "pitchProfile": {
      "type": "object",
      "required": ["pitchType", "role", "velocityTenthsKPH", "control", "command", "movement", "whiff", "weakContact", "fatigueCost"],
      "properties": {
        "pitchType": { "enum": ["four_seam", "slider", "curveball", "changeup"] },
        "role": { "enum": ["primary", "secondary", "development"] },
        "velocityTenthsKPH": { "type": "integer", "minimum": 1000, "maximum": 1700 },
        "control": { "$ref": "#/$defs/rating" },
        "command": { "$ref": "#/$defs/rating" },
        "movement": { "$ref": "#/$defs/rating" },
        "whiff": { "$ref": "#/$defs/rating" },
        "weakContact": { "$ref": "#/$defs/rating" },
        "fatigueCost": { "type": "integer", "minimum": 0, "maximum": 3 }
      },
      "additionalProperties": false
    },
    "pitcher": {
      "type": "object",
      "required": ["id", "name", "stuff", "command", "movement", "stamina"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "stuff": { "$ref": "#/$defs/rating" },
        "command": { "$ref": "#/$defs/rating" },
        "movement": { "$ref": "#/$defs/rating" },
        "stamina": { "$ref": "#/$defs/rating" },
        "pitchProfiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/pitchProfile" }
        }
      },
      "additionalProperties": false
    },
    "batter": {
      "type": "object",
      "required": ["id", "name", "contact", "discipline", "power"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "contact": { "$ref": "#/$defs/rating" },
        "discipline": { "$ref": "#/$defs/rating" },
        "power": { "$ref": "#/$defs/rating" }
      },
      "additionalProperties": false
    },
    "scouting": {
      "type": "object",
      "required": ["hotZone", "coldZone", "pitchStrength", "pitchWeakness", "chaseTendency"],
      "properties": {
        "hotZone": { "$ref": "#/$defs/zone" },
        "coldZone": { "$ref": "#/$defs/zone" },
        "pitchStrength": { "enum": ["four_seam", "slider", "curveball", "changeup"] },
        "pitchWeakness": { "enum": ["four_seam", "slider", "curveball", "changeup"] },
        "chaseTendency": { "$ref": "#/$defs/rating" }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["plateAppearanceID", "revision", "inning", "outs", "balls", "strikes", "pitchNumber", "scoreDifferential", "leverage", "fatigue"],
      "properties": {
        "plateAppearanceID": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 },
        "inning": { "type": "integer", "minimum": 1, "maximum": 20 },
        "outs": { "type": "integer", "minimum": 0, "maximum": 2 },
        "balls": { "type": "integer", "minimum": 0, "maximum": 3 },
        "strikes": { "type": "integer", "minimum": 0, "maximum": 2 },
        "pitchNumber": { "type": "integer", "minimum": 1 },
        "scoreDifferential": { "type": "integer" },
        "leverage": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "fatigue": { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "rivalObservation": {
      "type": "object",
      "required": ["pitchType", "zone", "zoneIntent", "balls", "strikes", "outcome"],
      "properties": {
        "pitchType": { "enum": ["four_seam", "slider", "curveball", "changeup"] },
        "zone": { "$ref": "#/$defs/zone" },
        "zoneIntent": { "enum": ["strike", "edge", "chase"] },
        "balls": { "type": "integer", "minimum": 0, "maximum": 3 },
        "strikes": { "type": "integer", "minimum": 0, "maximum": 2 },
        "outcome": { "enum": ["ball", "called_strike", "swinging_strike", "foul", "in_play_out", "single", "double", "home_run"] }
      },
      "additionalProperties": false
    },
    "rivalMemory": {
      "type": "object",
      "required": ["matchupID", "revision", "plateAppearancesSeen", "totalPitchesSeen", "recentObservations"],
      "properties": {
        "matchupID": { "type": "string", "minLength": 3 },
        "revision": { "type": "integer", "minimum": 0 },
        "plateAppearancesSeen": { "type": "integer", "minimum": 0 },
        "totalPitchesSeen": { "type": "integer", "minimum": 0 },
        "recentObservations": {
          "type": "array",
          "maxItems": 24,
          "items": { "$ref": "#/$defs/rivalObservation" }
        }
      },
      "additionalProperties": false
    },
    "defense": {
      "type": "object",
      "required": ["infield", "outfield", "arm"],
      "properties": {
        "infield": { "$ref": "#/$defs/rating" },
        "outfield": { "$ref": "#/$defs/rating" },
        "arm": { "$ref": "#/$defs/rating" }
      },
      "additionalProperties": false
    },
    "park": {
      "type": "object",
      "required": ["id", "name", "hitFactor", "homeRunFactor"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "hitFactor": { "type": "integer", "minimum": 700, "maximum": 1300 },
        "homeRunFactor": { "type": "integer", "minimum": 700, "maximum": 1300 }
      },
      "additionalProperties": false
    },
    "runners": {
      "type": "object",
      "required": ["firstOccupied", "secondOccupied", "thirdOccupied", "leadRunnerSpeed"],
      "properties": {
        "firstOccupied": { "type": "boolean" },
        "secondOccupied": { "type": "boolean" },
        "thirdOccupied": { "type": "boolean" },
        "leadRunnerSpeed": { "$ref": "#/$defs/rating" }
      },
      "additionalProperties": false
    },
    "gameState": {
      "type": "object",
      "required": ["defense", "park", "runners", "runsAllowed"],
      "properties": {
        "defense": { "$ref": "#/$defs/defense" },
        "park": { "$ref": "#/$defs/park" },
        "runners": { "$ref": "#/$defs/runners" },
        "runsAllowed": { "type": "integer", "minimum": 0, "maximum": 99 }
      },
      "additionalProperties": false
    },
    "analysisEntry": {
      "type": "object",
      "required": ["pitchType", "wasInZone", "batterSwung", "outcome", "selectionQuality", "executionQuality", "expectedDamage", "actualDamage", "recommendationAccepted"],
      "properties": {
        "pitchType": { "enum": ["four_seam", "slider", "curveball", "changeup"] },
        "wasInZone": { "type": "boolean" },
        "batterSwung": { "type": "boolean" },
        "outcome": { "enum": ["ball", "called_strike", "swinging_strike", "foul", "in_play_out", "single", "double", "home_run"] },
        "selectionQuality": { "enum": ["poor", "risky", "good", "excellent"] },
        "executionQuality": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "contactQuality": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "expectedDamage": { "type": "integer", "minimum": 0 },
        "actualDamage": { "type": "integer", "minimum": 0 },
        "recommendationAccepted": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "gameLog": {
      "type": "object",
      "required": ["gameID", "revision", "totalPitches", "entries"],
      "properties": {
        "gameID": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 },
        "totalPitches": { "type": "integer", "minimum": 0 },
        "entries": {
          "type": "array",
          "maxItems": 120,
          "items": { "$ref": "#/$defs/analysisEntry" }
        }
      },
      "additionalProperties": false
    },
    "pitchCall": {
      "type": "object",
      "required": ["pitchType", "zone", "zoneIntent", "intensity"],
      "properties": {
        "pitchType": { "enum": ["four_seam", "slider", "curveball", "changeup"] },
        "zone": { "$ref": "#/$defs/zone" },
        "zoneIntent": { "enum": ["strike", "edge", "chase"] },
        "intensity": { "enum": ["controlled", "normal", "max_effort"] }
      },
      "additionalProperties": false
    },
    "preparePitchParams": {
      "type": "object",
      "required": ["seed", "pitcher", "batter", "scouting", "context"],
      "properties": {
        "seed": { "type": "string", "pattern": "^[0-9]+$" },
        "pitcher": { "$ref": "#/$defs/pitcher" },
        "batter": { "$ref": "#/$defs/batter" },
        "scouting": { "$ref": "#/$defs/scouting" },
        "context": { "$ref": "#/$defs/context" },
        "rivalMemory": { "$ref": "#/$defs/rivalMemory" },
        "gameState": { "$ref": "#/$defs/gameState" },
        "gameLog": { "$ref": "#/$defs/gameLog" }
      },
      "additionalProperties": false
    },
    "submitPitchParams": {
      "type": "object",
      "required": ["seed", "pitcher", "batter", "scouting", "context", "preparationToken", "call"],
      "properties": {
        "seed": { "type": "string", "pattern": "^[0-9]+$" },
        "pitcher": { "$ref": "#/$defs/pitcher" },
        "batter": { "$ref": "#/$defs/batter" },
        "scouting": { "$ref": "#/$defs/scouting" },
        "context": { "$ref": "#/$defs/context" },
        "rivalMemory": { "$ref": "#/$defs/rivalMemory" },
        "gameState": { "$ref": "#/$defs/gameState" },
        "gameLog": { "$ref": "#/$defs/gameLog" },
        "preparationToken": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "call": { "$ref": "#/$defs/pitchCall" }
      },
      "additionalProperties": false
    }
  }
}
