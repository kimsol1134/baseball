<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Baseball.Platform</AssemblyName>
    <DefineConstants>UNITY_ANDROID;UNITY_6000_0_OR_NEWER;ENABLE_INPUT_SYSTEM</DefineConstants>
    <BaseballRepositoryRoot Condition="'$(BaseballRepositoryRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)/../..'))</BaseballRepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(BaseballRepositoryRoot)/apps/android-unity/Assets/Game/Platform/**/*.cs"
             Exclude="$(BaseballRepositoryRoot)/apps/android-unity/Assets/Game/Platform/InternalQa/**/*.cs" />
    <Compile Include="ExternalPackageStubs.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Baseball.Core"><HintPath>$(BaseballCoreDll)</HintPath></Reference>
    <Reference Include="$(UnityManaged)/*.dll" />
  </ItemGroup>

  <Target Name="ValidateUnityReferences" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(BaseballCoreDll)')" Text="The separately compiled Baseball.Core assembly is required." />
    <Error Condition="!Exists('$(UnityManaged)/UnityEngine.CoreModule.dll')" Text="Unity managed references are required." />
  </Target>
</Project>
