<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants>UNITY_EDITOR;UNITY_ANDROID;UNITY_6000_0_OR_NEWER</DefineConstants>
    <BaseballRepositoryRoot Condition="'$(BaseballRepositoryRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)/../..'))</BaseballRepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(BaseballRepositoryRoot)/apps/android-unity/Assets/Game/Editor/**/*.cs" />
    <Compile Include="EditorExternalPackageStubs.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(UnityManaged)/*.dll" />
    <Reference Include="UnityEditor.Android.Extensions"><HintPath>$(UnityAndroidEditorDll)</HintPath></Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime"><HintPath>$(UnityRenderCoreDll)</HintPath></Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime"><HintPath>$(UnityUrpDll)</HintPath></Reference>
  </ItemGroup>

  <Target Name="ValidateUnityEditorReferences" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(UnityManaged)/UnityEditor.dll')" Text="Unity 6000.3 Editor references are required." />
    <Error Condition="!Exists('$(UnityAndroidEditorDll)')" Text="Unity Android Editor extension is required." />
    <Error Condition="!Exists('$(UnityRenderCoreDll)')" Text="Unity Render Pipelines Core reference is required." />
    <Error Condition="!Exists('$(UnityUrpDll)')" Text="Unity URP reference is required." />
  </Target>
</Project>
