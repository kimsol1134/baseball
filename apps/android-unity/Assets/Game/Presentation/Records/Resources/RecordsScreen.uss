.records-hero {
    border-color: var(--baseball-positive);
    background-color: var(--baseball-positive-soft);
}

.records-screen .screen-data-row__value {
    color: var(--baseball-positive);
}

.life-card-capture {
    position: relative;
    overflow: hidden;
    min-height: var(--baseball-size-hero);
    padding: var(--baseball-space-6);
    border-width: var(--baseball-border-thin);
    border-color: var(--baseball-milestone);
    border-radius: var(--baseball-radius-large);
    background-color: var(--baseball-surface-raised);
}

.life-card-capture__backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    opacity: 0.18;
}

.life-card-capture__backdrop .screen-key-art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    border-width: 0;
}

.life-card-capture__content {
    position: relative;
}

.life-card-capture__title {
    margin-top: var(--baseball-space-2);
    color: var(--baseball-text-primary);
    font-size: var(--baseball-font-section);
    -unity-font-style: bold;
    white-space: normal;
}

.life-card-capture__lead {
    margin-top: var(--baseball-space-2);
    color: var(--baseball-text-secondary);
    font-size: var(--baseball-font-body);
    white-space: normal;
}

.life-card-capture__sections {
    margin-top: var(--baseball-space-4);
}

.life-card-capture__section {
    margin-top: var(--baseball-space-3);
    padding-top: var(--baseball-space-2);
    border-top-width: var(--baseball-border-thin);
    border-top-color: var(--baseball-border-subtle);
}

.life-card-capture__section-title {
    color: var(--baseball-milestone);
    font-size: var(--baseball-font-eyebrow);
    -unity-font-style: bold;
    white-space: normal;
}

.life-card-capture__rows {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: var(--baseball-space-1);
}

.life-card-capture__row {
    width: 50%;
    padding: var(--baseball-space-2);
}

.life-card-capture__row--narrative {
    width: 100%;
}

.life-card-capture__row-label {
    color: var(--baseball-text-secondary);
    font-size: var(--baseball-font-caption);
    white-space: normal;
}

.life-card-capture__row-value {
    color: var(--baseball-text-primary);
    font-size: var(--baseball-font-body);
    -unity-font-style: bold;
    white-space: normal;
}

.life-card-capture__row-detail {
    margin-top: var(--baseball-space-1);
    color: var(--baseball-text-secondary);
    font-size: var(--baseball-font-caption);
    white-space: normal;
}

.life-card-capture__footer {
    margin-top: var(--baseball-space-5);
    color: var(--baseball-milestone);
    font-size: var(--baseball-font-caption);
    -unity-font-style: bold;
}

.life-card-capture__portrait {
    width: 116px;
    min-width: 116px;
    height: 152px;
    margin-right: 0;
    margin-bottom: var(--baseball-space-3);
}

.baseball-font-scale-200 .life-card-capture__row {
    width: 100%;
}

.baseball-high-contrast .life-card-capture__backdrop {
    opacity: 0.06;
}

.life-archive-list {
    height: var(--baseball-size-hero);
    min-height: var(--baseball-size-hero);
    margin-top: var(--baseball-space-2);
}

.life-archive-list-item {
    min-height: var(--baseball-size-archive-row);
    padding-bottom: var(--baseball-space-2);
}

.life-archive-list-item__button {
    flex-grow: 1;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: var(--baseball-space-3);
    border-width: var(--baseball-border-thin);
    border-color: var(--baseball-border-subtle);
    border-radius: var(--baseball-radius-medium);
    background-color: var(--baseball-surface-raised);
}

.life-archive-list-item__button.is-selected {
    border-color: var(--baseball-positive);
    background-color: var(--baseball-positive-soft);
}

.life-archive-list-item__title {
    color: var(--baseball-text-primary);
    font-size: var(--baseball-font-body);
    -unity-font-style: bold;
    white-space: normal;
}

.life-archive-list-item__summary {
    margin-top: var(--baseball-space-1);
    color: var(--baseball-text-secondary);
    font-size: var(--baseball-font-caption);
    white-space: normal;
}

.life-archive-detail {
    margin-top: var(--baseball-space-4);
}

.baseball-font-scale-200 .life-archive-list {
    height: var(--baseball-size-archive-list-large);
}

.baseball-high-contrast .life-archive-list-item__button.is-selected {
    border-width: var(--baseball-border-thick);
}
