.screen-root {
    flex-grow: 1;
    min-height: 0;
}

.screen-scroll {
    flex-grow: 1;
}

/* Mobile screens scroll by touch; desktop-style tracks/arrows obscure content and do not exist
   in the iOS presentation. Keep scrolling enabled while hiding only the visual scrollers. */
.screen-scroll .unity-scroll-view__vertical-scroller,
.screen-scroll .unity-scroll-view__horizontal-scroller {
    display: none;
}

.screen-scroll .unity-scroll-view__content-container {
    width: 100%;
    max-width: 480px;
    align-self: center;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 32px;
}

.screen-scroll .unity-scroll-view__content-container > * {
    flex-shrink: 0;
}

.screen-hero {
    width: 100%;
    min-height: 128px;
    justify-content: flex-end;
    padding: 18px;
    margin-bottom: 16px;
    border-width: 1px;
    border-color: var(--baseball-border);
    border-radius: 14px;
    background-color: var(--baseball-surface-raised);
}

.screen-hero > * {
    flex-shrink: 0;
}

.screen-key-art {
    width: 100%;
    height: 184px;
    margin-bottom: 12px;
    border-radius: 14px;
    background-color: var(--baseball-surface-raised);
}

.baseball-font-scale-200 .screen-key-art {
    height: 136px;
}

.screen-lead {
    margin-top: 10px;
    color: var(--baseball-text-secondary);
    font-size: var(--baseball-font-body);
    white-space: normal;
}

.screen-custom,
.screen-sections,
.screen-actions {
    width: 100%;
}

.screen-custom {
    margin-bottom: 14px;
}

.screen-actions > .baseball-button {
    margin-top: 8px;
}

.screen-data-row {
    min-height: 52px;
    width: 100%;
    flex-direction: row;
    align-items: center;
    padding-top: 9px;
    padding-bottom: 9px;
    border-bottom-width: 1px;
    border-bottom-color: var(--baseball-border);
}

.screen-data-row__copy {
    min-width: 0;
    flex-grow: 1;
}

.screen-data-row__label {
    color: var(--baseball-text-primary);
    font-size: var(--baseball-font-body);
    -unity-font-style: bold;
    white-space: normal;
}

.screen-data-row__detail {
    margin-top: 3px;
    color: var(--baseball-text-secondary);
    font-size: var(--baseball-font-caption);
    white-space: normal;
}

.screen-data-row__value {
    max-width: 42%;
    margin-left: 12px;
    color: var(--baseball-action);
    font-size: var(--baseball-font-body);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    white-space: normal;
}

.baseball-font-scale-160 .screen-data-row,
.baseball-font-scale-200 .screen-data-row {
    flex-direction: column;
    align-items: flex-start;
}

.baseball-font-scale-160 .screen-data-row__value,
.baseball-font-scale-200 .screen-data-row__value {
    max-width: 100%;
    margin-left: 0;
    margin-top: 5px;
    -unity-text-align: middle-left;
}

.baseball-visual-choice {
    width: 100%;
    min-width: 0;
    flex-direction: row;
    align-items: stretch;
    margin-bottom: 8px;
}

.baseball-visual-choice > .baseball-choice-card {
    flex-grow: 1;
    min-width: 0;
    margin-bottom: 0;
}

.baseball-visual-choice__gallery {
    width: 218px;
    min-width: 218px;
    flex-direction: row;
    margin-right: 10px;
}

.baseball-visual-choice__gallery > .baseball-content-image--compact {
    width: 104px;
    min-width: 104px;
    margin-right: 5px;
}

.baseball-content-image,
.baseball-content-image--compact {
    overflow: hidden;
    border-radius: 12px;
    background-color: var(--baseball-surface-raised);
    border-width: 1px;
    border-color: var(--baseball-border);
}

.baseball-content-image {
    width: 100%;
    height: 184px;
    margin-bottom: 12px;
}

.baseball-content-image--compact {
    width: 104px;
    min-width: 104px;
    height: 136px;
    margin-right: 10px;
}

.screen-player-portrait {
    width: 116px;
    min-width: 116px;
    height: 152px;
    margin-top: 10px;
    margin-right: 0;
    margin-bottom: 0;
}

.baseball-content-image__image {
    width: 100%;
    height: 100%;
}

.baseball-content-image__fallback {
    width: 100%;
    height: 100%;
    padding: 10px;
    color: var(--baseball-text-secondary);
    font-size: var(--baseball-font-caption);
    white-space: normal;
    -unity-text-align: middle-center;
}

.baseball-font-scale-160 .baseball-visual-choice,
.baseball-font-scale-200 .baseball-visual-choice {
    flex-direction: column;
}

.baseball-font-scale-160 .baseball-visual-choice__gallery,
.baseball-font-scale-200 .baseball-visual-choice__gallery {
    width: 100%;
    min-width: 0;
    margin-right: 0;
    margin-bottom: 8px;
}

.baseball-font-scale-160 .baseball-visual-choice__gallery > .baseball-content-image--compact,
.baseball-font-scale-200 .baseball-visual-choice__gallery > .baseball-content-image--compact {
    width: 50%;
    min-width: 0;
    height: 168px;
    margin-right: 5px;
    margin-bottom: 0;
}

.baseball-font-scale-160 .baseball-content-image--compact,
.baseball-font-scale-200 .baseball-content-image--compact {
    width: 100%;
    height: 168px;
    margin-right: 0;
    margin-bottom: 8px;
}

.baseball-font-scale-200 .screen-player-portrait {
    width: 144px;
    min-width: 144px;
    height: 189px;
}

.screen-control-stack > * {
    flex-shrink: 0;
    margin-bottom: 8px;
}

.screen-choice-stack > .baseball-choice-card {
    margin-bottom: 8px;
}
