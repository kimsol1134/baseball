# Steamworks에서 App ID가 발급되면 실제 스토어 URL로 교체하세요.
NEXT_PUBLIC_STEAM_URL=https://store.steampowered.com/app/YOUR_APP_ID/
NEXT_PUBLIC_STEAM_DEMO_URL=https://store.steampowered.com/app/YOUR_DEMO_APP_ID/

# 모바일 웹 티저가 공개되기 전에는 비워 두어도 됩니다.
NEXT_PUBLIC_WEB_TEASER_URL=

# 배포한 Vercel 프로덕션 도메인. 메타데이터와 사이트맵에 사용됩니다.
NEXT_PUBLIC_SITE_URL=https://YOUR_PROJECT.vercel.app
