{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "야구 못하면 또 환생함",
  "version": "1.0.0",
  "identifier": "com.solkim.baseball",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "야구 못하면 또 환생함",
        "width": 1360,
        "height": 850,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/simulation-sidecar"
    ]
  }
}
