<resources>
    <color name="launch_background">#080D0B</color>
    <style name="Theme.BaseballLaunchBase" parent="Theme.BaseballMigration">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
    </style>
    <style name="Theme.BaseballLaunch" parent="Theme.BaseballLaunchBase" />
    <style name="Theme.BaseballMigration" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#C8A96B</item>
        <item name="android:navigationBarColor">#101820</item>
        <item name="android:statusBarColor">#101820</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
