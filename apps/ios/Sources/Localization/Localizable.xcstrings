        "ko" : { "stringUnit" : { "state" : "translated", "value" : "기질 특성 『%1$@』 — %2$@. 발동하면 승부 화면에 표시됩니다." } }
      }
    },
    "record.high-school.personality-rule" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your choices shape your personality. Game results do not change it." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "あなたの選択があなたの個性を形作ります。試合結果でそれは変わらない。" } },
