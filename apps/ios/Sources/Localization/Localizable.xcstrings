    "setup.karma.no-last-chance.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "One injury can end the career." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "一つの怪我がキャリアを終わらせる可能性がある。" } },
