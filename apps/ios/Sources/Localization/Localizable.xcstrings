    "setup.inheritance.legacy" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Signature Legacy · %@" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "シグネチャーレガシー · %@" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "대표 유산 · %@" } }
      }
    },
    "setup.inheritance.maxed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatic growth has reached its maximum (+20)." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "自動成長は最大値 (+20) に達しました。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "자동 성장은 최대치(+20)에 닿았습니다." } }
      }
    },
    "setup.inheritance.next-step" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Reach %lld inheritance points for +%lld automatic growth · max +20" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%lld 継承ポイントに到達すると +%lld 自動成長 · 最大 +20" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "계승 포인트 %lldP를 모으면 +%lld · 최대 +20" } }
      }
    },
    "setup.inheritance.points" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Inheritance points: %lld" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "継承ポイント：%lld" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "계승 포인트 %lld" } }
      }
    },
    "setup.inheritance.shop.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Inheritance points are the reward one player's career leaves for the next. Spend them here on rules that apply to this three-year high school career; your accumulated automatic-growth bonus stays intact." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "継承ポイントは、あるプレイヤーのキャリアが次のプレイヤーに残される報酬です。この 3 年間の高校生活に適用されるルールについてここで学びましょう。蓄積された自動成長ボーナスはそのまま残ります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "계승 포인트는 이전 선수의 커리어가 다음 선수에게 남긴 보상입니다. 여기서 이번 고교 3년에 적용할 규칙을 사고, 이미 쌓인 자동 성장 보너스는 줄지 않습니다." } }
      }
    },
    "setup.inheritance.shop.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Inheritance Shop" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "相続ショップ" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "계승 상점" } }
      }
    },
    "setup.inheritance.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Carried forward" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "繰り越し" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "가져온 것" } }
      }
    },
    "setup.legacy.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "One strength from past players carries over directly. Other Legacies remain unlocked and can be chosen again later." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "過去の選手の強みがそのまま引き継がれています。他のレガシーはロック解除されたままで、後で再度選択できます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지난 선수들이 남긴 강점 중 하나만 직접 이어집니다. 다른 유산은 사라지지 않고 다음에도 다시 고를 수 있습니다." } }
      }
    },
    "setup.legacy.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose a Signature Legacy for this player" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "このプレイヤーのシグネチャーレガシーを選択してください" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이번 선수에게 이어 줄 대표 유산" } }
      }
