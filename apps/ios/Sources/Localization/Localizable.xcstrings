      }
    },
    "settings.audio.footer" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sound won't stop music from other apps and follows the Ring/Silent switch." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "サウンドは他のアプリからの音楽を停止せず、着信/サイレントスイッチに従います。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "소리는 다른 앱의 음악을 멈추지 않고, 무음 스위치를 따릅니다." } }
      }
    },
    "settings.audio.haptics" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Haptics" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ハプティクス" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "진동" } }
      }
    },
    "settings.audio.haptics.footer" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "If you turn off haptics, the release meter will no longer wobble with game pressure. The meter's normal movement and fatigue-based aim shake remain." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ハプティクスをオフにすると、試合の圧力によってリリース メーターがぐらつきなくなります。メーターの通常の動きと疲労による照準のブレは残ります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "진동을 끄면 승부 긴장에 따른 릴리스 미터 흔들림도 사라집니다. 기본 미터 이동과 피로에 따른 조준 흔들림은 그대로입니다." } }
      }
    },
    "settings.audio.music" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Music" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "音楽" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "음악" } }
      }
    },
    "settings.audio.section-title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sound & Haptics" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "サウンドとハプティクス" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "소리와 진동" } }
      }
    },
    "settings.auto-release.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn it on to pitch with one tap, without timing the windup. The result matches a perfectly centered release." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "オンにすると、ワインドアップのタイミング操作なしで、1回のタップで投球できます。結果は中央で完璧にリリースした場合と同じです。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "켜면 와인드업 타이밍 없이 탭 한 번으로 던집니다. 결과는 릴리스가 딱 중간일 때와 같습니다." } }
      }
    },
    "settings.auto-release.footer" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn this on if timing gestures are difficult. Every pitch uses a steady mid-release, so you won't get stuck—but you give up the edge of perfect timing." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "タイミング操作が難しい場合にオンにしてください。毎球安定した中央リリースになるため進行不能にはなりませんが、完璧なタイミングの追加効果は得られません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "타이밍 제스처가 어려우면 켜세요. 항상 안정된 중간 릴리스로 던지므로 진행이 막히는 일은 없습니다. 다만 완벽한 타이밍의 이점도 사라집니다." } }
      }
    },
    "settings.auto-release.label" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Auto Release" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "オートリリース" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "자동 릴리스" } }
      }
    },
    "settings.audio.sound" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sound" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "サウンド" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "소리" } }
