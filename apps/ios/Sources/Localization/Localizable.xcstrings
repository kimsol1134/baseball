      }
    },
    "pro.locked.skip.button" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Start pro now, skipping high school" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "高校をスキップして今すぐプロを始める" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "고교를 건너뛰고 바로 프로 시작" } }
      }
    },
    "pro.locked.skip.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "If you skip ahead, the draft result is generated from your seed. You won't carry growth or memories from high school." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "先にスキップすると、シードからドラフト結果が生成されます。高校時代の成長や思い出は持ち越せません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "건너뛰면 지명 결과가 시드에서 만들어집니다. 고교 3년의 성장과 기억은 없습니다." } }
      }
    },
    "pro.locked.skip.locked" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Finish one three-year high school career to unlock the option to skip ahead." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "3 年間の高校生活を終えて、スキップして先に進むオプションのロックを解除します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "고교 3년을 한 번 마치면 고교를 건너뛰는 길도 열립니다." } }
      }
    },
    "pro.locked.title" : {
      "localizations" : {
