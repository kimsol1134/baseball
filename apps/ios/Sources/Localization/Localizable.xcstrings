        "ko" : { "stringUnit" : { "state" : "translated", "value" : "프로 커리어를 완전히 지울까요?" } }
      }
    },
    "error.career.open.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't open career" } },
