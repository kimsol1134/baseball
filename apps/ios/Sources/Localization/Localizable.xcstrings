    "legacy.recap.points.spend" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Spend the balance in the Legacy Shop during rebirth—break talent walls, carry more memories, or change your growth rhythm." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "転生 中にレガシー ショップで残高を費やして、才能の壁を打ち破ったり、より多くの思い出を持ち運んだり、成長リズムを変えたりしましょう。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "잔액은 환생할 때 계승 상점에서 씁니다 — 재능 돌파·기억 확장·성장 리듬." } }
      }
    },
    "legacy.recap.points.save" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "These points came from your last player's career. Earn more to buy new rules for the next player in the Legacy Shop." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "これらのポイントは、最後のプレーヤーのキャリアから得られたものです。さらに稼いで、レガシーショップで次のプレイヤーのために新しいルールを購入しましょう。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이전 선수의 커리어가 남긴 포인트입니다. 더 쌓이면 계승 상점에서 새 선수의 규칙을 살 수 있습니다." } }
      }
    },
