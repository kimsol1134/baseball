    "setup.handicap.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Up to two. Each makes this three-year career harder, but gives the next player more to inherit. Current bonus: +%lld%%" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "2つまで。それぞれがこの3年間のキャリアをより困難なものにするが、次の選手に受け継ぐものはさらに多くなる。現在のボーナス: +%lld%%" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "최대 2개. 고르면 이번 고교 3년이 어려워집니다. 대신 새 선수가 이어받는 힘이 커집니다. 지금 +%lld%%" } }
      }
    },
    "setup.handicap.label" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Handicaps" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ハンディキャップ" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "핸디캡" } }
      }
    },
    "setup.handicap.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "How hard should this three-year high school career be?" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この3年間の高校生活はどれほど大変なものでしょうか？" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이번 고교 3년을 얼마나 어렵게 갈까요?" } }
      }
    },
    "setup.inheritance.automatic-growth" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "From past players' accumulated points: +%lld automatic growth for this player · %lld points available in the Inheritance Shop" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "過去のプレイヤーの蓄積ポイントから: +%lld このプレイヤーの自動成長 · 継承ショップで利用可能な %lld ポイント" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지난 선수들이 남긴 누적 포인트 중 이번 선수 능력에 자동 성장 +%lld · 계승 상점에서 쓸 수 있는 포인트 %lld" } }
      }
    },
    "setup.inheritance.empty-memories" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No memories carried forward." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "引き継がれる記憶はありません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "가져온 기억이 없습니다." } }
      }
