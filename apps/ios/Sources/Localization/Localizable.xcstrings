    "legacy.bloom.meaning.d" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A blocked path has cracked open. Keep training to turn persistence into growth." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "塞がれていた道が裂けて開いた。粘り強さを成長に変えるためにトレーニングを続けてください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "막혀 있던 길이 열렸습니다. 계속 훈련해 버틴 시간을 성장으로 바꾸세요." } }
      }
    },
    "legacy.bloom.meaning.c" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This ability can now reach a new level with continued work." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この能力は、継続的に取り組むことで新たなレベルに到達できるようになりました。" } },
