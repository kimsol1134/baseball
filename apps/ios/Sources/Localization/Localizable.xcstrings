      }
    },
    "legacy.bloom.meaning.b" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A strong talent has opened farther. The next tier is within reach." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "強力な才能がさらなる飛躍を遂げた。次の階層は手の届くところにあります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "좋은 재능이 더 멀리 열렸습니다. 다음 단계가 사정권에 들어왔습니다." } }
      }
    },
    "legacy.bloom.meaning.a" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Elite potential is now open. This ability can become a defining weapon." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "エリートの可能性が開かれています。この能力は決定的な武器になる可能性があります。" } },
