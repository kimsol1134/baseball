        "ko" : { "stringUnit" : { "state" : "translated", "value" : "프로 저장과 백업을 모두 지운다" } }
      }
    },
    "error.career.delete.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your current save and recovery backup will be deleted. This cannot be undone." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "현재 저장본과 복구용 백업이 함께 삭제됩니다. 되돌릴 수 없습니다." } }
      }
