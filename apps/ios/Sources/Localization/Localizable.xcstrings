    "pro.legacy-handoff.link-broken.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Can't Link This Record to the Current Life" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この記録を現在の人生に結び付けられません" } },
