    "notification.return.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your next baseball decision is waiting." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다음 야구 선택이 기다립니다." } }
      }
    },
    "notification.return.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Return to the mound" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "마운드로 돌아오세요" } }
      }
    },
    "opening.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You won't pitch every game. You take the mound only when your choices can change the outcome." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "모든 경기를 던지지 않습니다. 결과를 바꿀 수 있는 순간에만 마운드에 오릅니다." } }
      }
    },
    "opening.eyebrow" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Three years of high school. One draft." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "고교 3년, 한 번의 드래프트" } }
      }
    },
    "opening.start" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Start" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "시작하기" } }
      }
    },
    "opening.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You are a high school pitcher.\nGet drafted into the pros within three years." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "당신은 고교 투수입니다.\n3년 안에 프로 지명을 받아야 합니다." } }
      }
    },
    "prologue.ability.accessibility" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@, current rating %lld, %@, %@." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@, 현재 능력치 %lld, %@, %@." } }
      }
    },
    "prologue.ability.ceiling-reached" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You've reached this talent ceiling. Keep training to break through." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "재능의 한계에 닿았습니다. 계속 훈련하면 열립니다." } }
      }
    },
    "prologue.ability.ceiling" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Up to %lld" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%lld까지" } }
      }
    },
    "prologue.ability.explanation" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The big number is your current rating; the letter is the ceiling training can reach. A high talent grade does not mean the current rating starts high." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "큰 숫자가 지금 실력이고, 알파벳은 훈련으로 닿을 수 있는 한계입니다. 재능이 높아도 지금 수치가 낮을 수 있습니다." } }
      }
    },
    "prologue.ability.no-ceiling" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No ceiling" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "한계 없음" } }
      }
    },
    "prologue.ability.talent" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Talent %@" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "재능 %@" } }
      }
    },
