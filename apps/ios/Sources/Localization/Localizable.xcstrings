    },
    "legacy.career-error.reset.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Everything earned across rebirths will disappear. This cannot be undone." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "生まれ変わって得たものはすべて消えてしまいます。これを元に戻すことはできません。" } },
