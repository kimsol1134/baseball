        "ja" : { "stringUnit" : { "state" : "translated", "value" : "テクニック" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "기술" } }
      }
    },
    "setup.soul-domain.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Where should the %lldP of automatic growth go?" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "自動成長の %lldP はどこに行けばよいですか?" } },
