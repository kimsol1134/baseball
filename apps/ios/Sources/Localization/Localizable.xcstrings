    "pro.locked.path.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Spend three years in High School, clear the draft, and enter the pros with the abilities you built." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "高校3年間を過ごし、ドラフトを突破し、培った実力を活かしてプロ入り。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "고교 탭에서 3년을 보내고 드래프트를 통과하면, 그때의 능력을 그대로 안고 프로에 들어갑니다." } }
      }
    },
    "pro.locked.path.title" : {
      "localizations" : {
