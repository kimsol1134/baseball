    "setup.quick-rebirth.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Rebirth shortcut" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "転生 ショートカット" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "바로 환생" } }
      }
    },
    "setup.region.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This is where you played your final middle-school tournament. Four high schools from the region are reaching out." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ここは中学校最後の大会が行われた場所です。地域の高校４校が参加している。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "중학교 마지막 대회를 치른 지역입니다. 이 지역의 네 고교가 손을 내밉니다." } }
      }
    },
    "setup.region.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Where will you start?" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "どこから始めますか?" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "어느 지역에서 시작할까요?" } }
      }
    },
    "setup.seed.challenge-summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Play with the same conditions as player %lld, without inherited help. The result won't count toward player records or inheritance points." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "継承されたヘルプなしで、プレーヤー %lld と同じ条件でプレイします。結果はプレイヤーの記録や継承ポイントにはカウントされません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "기록 없는 도전 — %lld번째 선수와 같은 조건을 계승 도움 없이 엽니다. 결과는 선수 기록·계승 포인트에 남지 않습니다." } }
      }
    },
    "setup.seed.error" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter a number seed or the share code exactly as it appears on the card." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "カードに表示されている番号シードまたは共有コードを正確に入力します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "숫자 시드나 카드에 적힌 공유 코드를 그대로 입력해 주세요." } }
      }
    },
    "setup.seed.placeholder" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Seed or card share code (optional)" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "シードまたはカード共有コード (オプション)" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "시드 또는 카드 공유 코드 (선택)" } }
      }
    },
    "setup.seed.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A number seeds player %lld. To recreate a card challenge, enter the card's share code." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ナンバーシードプレイヤー%lld。カード チャレンジを再作成するには、カードの共有コードを入力します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "숫자만 입력하면 지금 만들 %lld번째 선수의 조건입니다. 카드와 똑같이 도전하려면 카드의 공유 코드를 입력하세요." } }
      }
    },
    "setup.seed.validation" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Check the seed input — %@" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "シード入力を確認します — %@" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "시드 입력을 확인해 주세요 — %@" } }
      }
    },
    "setup.soul-domain.body.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Stuff and stamina come first. Build the arm to last deep into games." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "球威とスタミナが第一です。試合に長く耐えられる腕を鍛えましょう。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "구위와 체력에 먼저 들어갑니다. 긴 이닝을 버티는 쪽입니다." } }
      }
    },
    "setup.soul-domain.body.label" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Body" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "本体" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "몸" } }
      }
    },
    "setup.soul-domain.game.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Command and batter plans come first. Survive with better pitch-by-pitch decisions." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "制球 とバッタープランが最初に来ます。投球ごとのより良い判断で生き残れます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "제구와 타자 상대법에 먼저 들어갑니다. 수 싸움으로 버티는 쪽입니다." } }
      }
    },
    "setup.soul-domain.game.label" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Game plan" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "試合プラン" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "경기 운영" } }
      }
    },
    "setup.soul-domain.rule" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Half goes to your chosen area first; the rest fills your lowest abilities. Talent limits still apply." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "半分は最初に選択したエリアに行きます。残りはあなたの最低の能力を補います。才能制限は依然として適用されます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "고른 쪽에 절반이 먼저 가고, 나머지는 가장 낮은 능력부터 채웁니다. 재능의 한계는 넘지 않습니다." } }
      }
    },
    "setup.soul-domain.technique.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Command and breaking balls come first. Put the pitch where you want it." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "制球 と 変化球 が最初に来ます。投球を好きな場所に置きます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "제구와 변화구에 먼저 들어갑니다. 원하는 곳에 꽂는 쪽입니다." } }
      }
    },
    "setup.soul-domain.technique.label" : {
