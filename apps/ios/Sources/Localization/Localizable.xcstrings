    "pitch.delivery.accessibility.hint" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold to wind up, drag to steady the target, then release to pitch. Turn on Auto Release to pitch with one activation." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "押し続けて巻き上げ、ドラッグしてターゲットを安定させ、放すと投球になります。自動リリースをオンにすると、1 回のアクティベーションで投球できます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "길게 눌러 와인드업하고, 끌어서 조준한 뒤 떼면 던집니다. 설정에서 자동 릴리스를 켜면 탭 한 번으로 던집니다." } }
      }
    },
