    "setup.quick-rebirth.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ · %@ · Same setup as your last player" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ · %@ · 最後のプレーヤーと同じセットアップ" } },
