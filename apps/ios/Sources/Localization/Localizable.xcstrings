    "settings.delete.confirm.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your player records and inherited legacies will be erased too." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "プレーヤーの記録と継承された遺産も消去されます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "선수 기록과 계승 유산까지 전부 사라집니다." } }
      }
    },
    "settings.delete.confirm.title" : {
      "localizations" : {
