    "pro.retired.legacy.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn the Pro Career into a Signature Legacy" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "プロのキャリアを特徴的なレガシーに変える" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "프로 기록을 대표 유산으로 남기기" } }
      }
    },
    "pro.retired.soul.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn the Pro Career into Legacy Points" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "プロのキャリアをレガシーポイントに変える" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "프로 기록을 계승 포인트로 남기기" } }
      }
    },
    "pro.retired.legacy.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your growth and career record—from high school through retirement—will reveal three Signature Legacies. You choose one to pass directly to the next player." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "高校時代から退職までのあなたの成長とキャリアの記録から、3 つの特徴的な遺産が明らかになります。次のプレイヤーに直接渡すものを選択します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "고교 시절부터 은퇴까지 직접 키운 능력과 통산 기록으로 대표 유산 세 가지를 찾습니다. 그중 하나를 다음 선수에게 직접 남길 수 있습니다." } }
      }
    },
    "pro.retired.soul.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A pro career started outside the high-school path becomes Legacy Points. Spend them on the current high-school player or the next player's inheritance shop." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "高校卒業後に始めたプロのキャリアはレガシーポイントとなります。それらを現在の高校生プレイヤーまたは次のプレイヤーの継承ショップに費やします。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "고교를 건너뛰고 시작한 프로 기록은 계승 포인트로 남습니다. 진행 중인 고교 선수나 다음 고교 선수의 계승 상점에서 사용할 수 있습니다." } }
      }
    },
    "pro.retired.soul-points" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Legacy Points +%lld" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "レガシーポイント +%lld" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "계승 포인트 +%lld" } }
      }
    },
