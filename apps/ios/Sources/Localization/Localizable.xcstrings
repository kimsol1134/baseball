      }
    },
    "setup.style.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Only your starting ratings differ. Training over three years can change everything." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "異なるのは開始時の評価だけです。 3 年間のトレーニングですべてが変わります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "시작 능력치만 다릅니다. 3년 동안의 훈련으로 얼마든지 바뀝니다." } }
      }
