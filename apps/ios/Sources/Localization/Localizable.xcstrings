      }
    },
    "setup.name.stadium-caption" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This name will echo through this ballpark for three years." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "この名前は３年間、この球場に響き渡るだろう。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 이름이 3년 동안 이 구장에서 불립니다." } }
