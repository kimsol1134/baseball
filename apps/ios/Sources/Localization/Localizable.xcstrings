      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ branch, Tier %lld, %@, owned." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%@ ブランチ、ティア %lld、%@、所有。" } },
