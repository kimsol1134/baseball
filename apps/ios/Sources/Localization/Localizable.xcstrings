    "pitch.coach.first" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "1. Hold to wind up, then release in the green center. Your catcher has already called the pitch and location." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "1. 押し続けて巻き上げ、緑色の中央で放します。あなたの捕手はすでに投球とコースを呼び出しています。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "① 길게 눌러 와인드업 — 미터가 가운데 초록에 올 때 떼자. 구종과 코스는 포수가 골라 뒀다." } }
