    "setup.challenge.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Past memories, Signature Legacies, inheritance points, and handicaps are disabled. Only your chosen difficulty and direct pitching affect this challenge." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "過去の記憶、シグネチャーレガシー、継承ポイント、ハンディキャップは無効になります。選択した難易度と直接投球のみがこのチャレンジに影響します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지난 선수의 기억·대표 유산·계승 포인트·핸디캡은 쓰지 않습니다. 고른 난이도와 직접 투구만 이 판에 반영됩니다." } }
