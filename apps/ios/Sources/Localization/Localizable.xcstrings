    "pitch.intent.chase.middle.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "From the middle target, this call finishes below the zone. It can earn a chase, but is more likely to be a ball." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "中央のターゲットから、このコールはゾーンの下で終了します。チェイスを稼ぐことはできますが、ボールになる可能性が高くなります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "한복판에서는 낮은 쪽으로 빼는 공이 됩니다. 헛스윙을 노리는 대신 볼이 될 확률이 큽니다." } }
      }
