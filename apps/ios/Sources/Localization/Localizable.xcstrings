    "setup.inheritance.shop.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Inheritance points are the reward one player's career leaves for the next. Spend them here on rules that apply to this three-year high school career; your accumulated automatic-growth bonus stays intact." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "계승 포인트는 이전 선수의 커리어가 다음 선수에게 남긴 보상입니다. 여기서 이번 고교 3년에 적용할 규칙을 사고, 이미 쌓인 자동 성장 보너스는 줄지 않습니다." } }
