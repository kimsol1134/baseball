    "legacy.pledge.card-title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Three-Year Goal" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "3年間の目標" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "고교 3년 목표" } }
      }
    },
    "legacy.pledge.intro.first" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose one and we will revisit it after three years. Complete it to give your next player a stronger start." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "どれか 1 つを選択してください。3 年後に再検討します。それを完了すると、次のプレイヤーがより強力なスタートを切ることができます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "하나를 고르면 3년을 마칠 때 돌아봅니다. 이루면 새 선수가 더 강하게 시작됩니다." } }
      }
    },
    "legacy.pledge.intro.repeat" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose one and we will revisit it after three high-school years. Harder tiers award more Legacy Points." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "どれか 1 つを選んでください。高校 3 年間後に再検討します。レベルが高くなるほど、より多くのレガシー ポイントが獲得できます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "하나를 고르면 고교 3년을 마칠 때 돌아봅니다. 등급에 따라 계승 포인트를 더 얻습니다." } }
      }
    },
