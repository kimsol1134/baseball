    "setup.quick-rebirth.hint" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Continue through setup below to use the Inheritance Shop." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "継承ショップを使用するには、以下のセットアップを続行します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "계승 상점을 쓰려면 아래에서 단계대로 진행하세요." } }
