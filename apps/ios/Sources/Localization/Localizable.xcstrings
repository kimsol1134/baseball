    "pro.legacy-handoff.link-broken.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This retired player's pro record belongs to a different life than the high-school career in progress. Keep only the Legacy Points and clear the pro record to start the next player." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "引退した選手のプロ記録は、進行中の高校の人生とは別の人生のものです。レガシーポイントだけを残してプロ記録を整理すると、次の選手を始められます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "은퇴한 선수의 프로 기록이 지금 진행 중인 고교 회차와 달라 그대로 연결할 수 없습니다. 계승 포인트 보상만 남기고 프로 기록을 정리하면 다음 선수를 시작할 수 있습니다." } }
      }
    },
    "pro.legacy-handoff.link-broken.fallback-action" : {
