      }
    },
    "awakening.read-only.empty" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No skills selected yet. At the next awakening, choose one Tier 1 skill from any of the four branches." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "아직 찍은 스킬이 없습니다. 다음 각성에서 네 갈래의 1단 스킬 중 하나를 고릅니다." } }
      }
    },
    "awakening.read-only.progress" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld/%lld skills chosen · %lld choices left" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "찍은 스킬 %lld/%lld · 남은 선택 %lld회" } }
      }
    },
    "awakening.selection.guidance" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Take one skill to unlock the next node in that branch. %lld awakenings remain after this pick — finish one branch or spread your picks across several." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "하나를 찍으면 그 갈래의 다음 가지가 열립니다. 남은 각성 %lld번 — 한 갈래를 끝까지 팔지, 여러 갈래를 나눠 가질지 고르세요." } }
      }
    },
    "awakening.sheet.done" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Done" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "완료" } }
      }
    },
    "awakening.sheet.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "My Skill Tree" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "내 스킬트리" } }
      }
    },
    "awakening.spark.before-first-game" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You have not had a game to prove yourself yet — nodes unlock in order. A strong outing can unlock a one-tier skip at the next awakening." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "아직 증명할 무대가 없었습니다 — 순서대로만 열립니다. 마운드의 호투가 다음 각성에서 건너뛰기를 엽니다." } }
      }
    },
    "awakening.spark.leaps" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A strong season has unlocked a one-tier skip — you can take a node one tier ahead." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "시즌의 호투가 몸을 완전히 깨웠습니다 — 한 단계를 건너뛰고 찍을 수 있습니다." } }
      }
    },
    "awakening.spark.needs-proof" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You have not earned a skip yet — nodes unlock in order for now. Strong outings (scoreless frames and strikeout shows) and talent breakthroughs can unlock a one-tier skip at the next awakening." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "전조가 부족합니다 — 이번에는 순서대로만 열립니다. 호투(무실점·삼진쇼)와 만개가 다음 각성에서 건너뛰기를 엽니다." } }
      }
    },
    "awakening.summary.empty" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No skills chosen yet · See your next path" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "아직 찍은 스킬 없음 · 다음 경로 확인" } }
