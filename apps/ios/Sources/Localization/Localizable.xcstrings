    "league.interpretation.fip-lower" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your RA9 is above your FIP. Defense and luck have worked against you, so the same process could produce better results." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "RA9 は FIP を上回っています。防御と運があなたに不利に働いたため、同じプロセスでより良い結果が得られる可能性があります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "실점이 FIP보다 높습니다. 수비와 운이 불리하게 작용했다는 뜻이라, 같은 내용이면 성적이 좋아질 여지가 있습니다." } }
      }
    },
    "league.interpretation.fip-higher" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your RA9 is below your FIP. Defense and luck have helped, so results may slip if the process stays the same." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "RA9 は FIP を下回っています。防御と運が助けになったので、プロセスが同じままだと結果がずれる可能性があります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "실점이 FIP보다 낮습니다. 수비와 운이 도왔다는 뜻이라, 내용이 그대로면 성적은 나빠질 수 있습니다." } }
      }
    },
    "league.interpretation.aligned" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your RA9 and FIP are close. The results match the quality of your pitching." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "RA9 と FIP は近いです。結果はあなたの投球の質と一致します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "실점과 FIP가 비슷합니다. 지금 성적이 내용 그대로라는 뜻입니다." } }
      }
    },
    "league.method-note" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The game tracks runs, not earned runs, so it uses RA9 instead of ERA. A quality start is 6+ innings with 3 or fewer runs allowed." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "試合では自責点ではなく得点が記録されるため、ERA ではなく RA9 が使用されます。クォリティスタートとは、6イニング以上、許される失点が3以下のことを指します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "자책점을 따로 세지 않아 평균자책점 대신 9이닝당 실점을 씁니다. 퀄리티스타트도 6이닝 3실점 이하 기준입니다." } }
      }
    },
