    "setup.name.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You'll be called this name throughout your three-year high school career." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "高校生活の3年間ずっとこの名前で呼ばれることになります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "고교 3년 동안 이 이름으로 불립니다." } }
      }
    },
    "setup.name.rebirth-caption" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your past-life memories are waiting for a new name." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "あなたの過去世の記憶は、新しい名前を待っています。" } },
