    "reminder.nudge.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "At 7:30 PM each day, we’ll remind you of the next goal for your current player or one inning to pick up where you left off. Reminders stop automatically if you don’t open the game for a few days." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "毎日午後 7 時 30 分に、現在のプレーヤーの次の目標、または中断したところから再開する 1 イニングを通知します。数日間試合を開かないと、リマインダーは自動的に停止します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "매일 저녁 7시 30분, 지금 키우는 선수의 다음 목표나 그날의 이닝 중 이어 할 한 가지를 알려 드립니다. 며칠 안 열면 저절로 멈춥니다." } }
      }
    },
