    ,"pitch.coach.put-away" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "3. Put-away pitch. Attack the hitter's weakness just off the zone and make them chase." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "③ 결정구 — 상대가 약한 구종으로 유인하자. 존을 살짝 벗어나도 방망이가 나온다." } }
      }
    }
    ,"pitch.coach.second" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "2. Do not show the same look twice. Change speed or location to disrupt the hitter's timing." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "② 같은 곳에 두 번은 없다 — 구종이나 코스를 바꿔 타자의 눈을 흔들자." } }
