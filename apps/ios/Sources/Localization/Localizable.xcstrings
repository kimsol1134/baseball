    "setup.karma.capacity-hint" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You can choose up to two handicaps. Remove one before choosing another." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ハンディキャップは2つまで選択できます。別のものを選択する前に、1 つを削除してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "핸디캡은 두 개까지 고를 수 있습니다. 다른 것을 빼면 고를 수 있습니다." } }
