    "awakening.confirmation.action" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose this awakening" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이걸로 각성한다" } }
      }
    },
    "awakening.confirmation.cancel" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose again" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다시 고른다" } }
      }
    },
    "awakening.confirmation.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ branch, Tier %lld\n%@\n\nOnce chosen, this awakening cannot be changed during your three-year high school career." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@ 갈래 %lld단\n%@\n\n한 번 고르면 고교 3년 동안 바꿀 수 없습니다." } }
      }
    },
    "awakening.confirmation.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose %@ as your awakening?" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@ 각성할까요?" } }
      }
    },
    "awakening.counter" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You get %lld awakenings across high school — this is awakening %lld." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "고교 3년 동안 %lld번 각성합니다 — 지금은 %lld번째입니다." } }
      }
    },
    "awakening.guide" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A checkmark means owned. “Next” means available at the next awakening. Locked nodes show the skill you need first." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "체크는 현재 보유, ‘다음’은 다음 각성에서 고를 수 있는 스킬입니다. 잠긴 가지에는 먼저 필요한 스킬이 표시됩니다." } }
      }
    },
    "awakening.key-art.eyebrow" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Awakening" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "각성" } }
      }
    },
    "awakening.key-art.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your Body Remembers One Thing" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "몸이 하나를 기억합니다" } }
      }
    },
    "awakening.node.leap" : {
