    "legacy.pledge.accessibility.carried" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Carried over from the last player. %1$@ goal, %2$@, %3$@, Legacy Point reward +%4$lld percent" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "最後のプレイヤーから引き継がれました。 %1$@ 目標、%2$@、%3$@、レガシーポイント報酬 +%4$lld パーセント" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지난 고교 3년에서 이어진 %1$@ 목표, %2$@, %3$@, 보상 계승 포인트 %4$lld퍼센트 추가" } }
      }
    },
    "legacy.pledge.alignment.control" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your best rating is Control, making this a natural fit for limiting walks." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "あなたの最高評価は 制球 で、これは四球を制限するのに自然に適合します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "제구가 가장 높은 능력이라 볼넷 억제에 잘 맞습니다." } }
      }
    },
    "legacy.pledge.alignment.evaluation" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This turns your Control strength into an overall draft grade." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "これにより、あなたの 制球 の強さがドラフト全体のグレードに変わります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "제구 강점을 전체 평가로 이어 가는 목표입니다." } }
      }
    },
    "legacy.pledge.alignment.power" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This turns your Stuff and Breaking strengths into game results." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "球威と変化球の強みを試合結果につなげる目標です。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "구위와 변화구 강점을 경기 결과로 바꾸는 목표입니다." } }
      }
    },
    "legacy.pledge.alignment.relationship" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This turns your strongest relationship into an edge in competition." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "これにより、最も強力な関係が競争における優位性に変わります。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지금 가장 두터운 관계를 승부의 힘으로 잇는 목표입니다." } }
      }
    },
    "legacy.pledge.alignment.health" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This fits a run built around managing your current arm load." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "これは、現在の腕の負荷を管理することを中心に構築されたランニングに適合します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "현재 팔 부담을 관리하며 완주하는 데 맞춘 목표입니다." } }
      }
    },
    "legacy.pledge.alignment.fans" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This builds the fan interest you already earned into a larger story." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "これにより、すでに獲得したファンの関心がさらに大きなストーリーに組み込まれます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이미 모인 팬 관심을 더 큰 이야기로 잇는 목표입니다." } }
      }
    },
    "legacy.pledge.alignment.current" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This proves the strengths you have built so far." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "これはあなたがこれまで築き上げてきた強みを証明します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지금 키운 강점을 끝까지 증명하는 목표입니다." } }
      }
    },
    "legacy.pledge.alignment.safe" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A safe goal you can finish with any current build." } },
