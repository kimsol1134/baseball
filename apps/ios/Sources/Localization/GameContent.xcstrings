    },
    "content.event.evt-injury-rumor.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A teammate who saw you rub your shoulder asks whether the coach should know." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "어깨를 주무르는 모습을 본 동료가 코치에게 말해야 하지 않느냐고 묻습니다." } }
