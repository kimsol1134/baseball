        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@ 능력이 재능의 한계에 닿았습니다. 계속 훈련하면 한계가 열릴 수 있습니다." } }
      }
    },
    "content.training-result.detail.growth" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ rating increased by %lld." } },
