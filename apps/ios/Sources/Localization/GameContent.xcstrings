    },
    "content.prologue.first-life.context" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@'s final middle-school tournament put you on the radar of four high schools in the area." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@ 중학교 마지막 대회에서 보여준 공이 같은 지역 네 고교의 관심을 끌었습니다." } }
      }
    },
    "content.prologue.repeat-life-1.context" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "It was your first time on the mound at %@, but the dirt felt familiar. Four high schools are watching again." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@ 중학교 마지막 대회. 처음 서는 마운드인데 흙의 감촉이 낯설지 않았습니다. 같은 지역 네 고교가 다시 지켜보고 있습니다." } }
      }
    },
    "content.prologue.repeat-life-2.context" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The last pitch of your final middle-school tournament at %@ sounded familiar as it hit the catcher's mitt. Four high schools are taking notice." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@ 중학교 마지막 대회에서 던진 마지막 공. 포수 미트에 꽂히는 소리가 어딘가 익숙했습니다. 네 고교의 시선이 모입니다." } }
      }
    },
    "content.prologue.repeat-life-3.context" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "After your final middle-school tournament at %@, your mind was preparing for the next inning before your shoulder had caught up. A high school offer has arrived." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@ 중학교 마지막 대회를 마친 뒤, 어깨보다 먼저 마음이 다음 이닝을 준비하고 있었습니다. 네 고교에서 제안이 도착했습니다." } }
      }
    },
    "content.prologue.fallback.context" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your last middle-school outing put you on the radar of four high schools." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "중학교 마지막 대회에서 보여준 공이 네 고교의 관심을 끌었습니다." } }
      }
    },
