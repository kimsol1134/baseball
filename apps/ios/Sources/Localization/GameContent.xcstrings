    "content.nickname.nine-k.reason" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Six-plus strikeouts per game — one arm handles most of the outs." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "경기당 탈삼진 6개 이상 — 아웃 카운트 대부분을 혼자 책임집니다." } }
      }
    },
    "content.nickname.workhorse.reason" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Completed all %lld official high-school games — an arm that refuses to leave the mound." } },
