        "en" : { "stringUnit" : { "state" : "translated", "value" : "Three walks per game — the joke is that even the pitcher doesn't know where it goes." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "경기당 볼넷 3개 — 공이 어디로 갈지 본인도 모른다는 놀림입니다." } }
