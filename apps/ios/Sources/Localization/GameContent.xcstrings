    "content.career-wind.v1.calm.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A quiet season" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "바람 없는 해" } }
      }
    },
    "content.career-wind.v1.calm.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Nothing unusual shapes this year. Your ability has to do the talking." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "특별할 것 없는 평범한 해입니다. 실력만이 말합니다." } }
      }
    },
    "content.career-wind.v1.monster_generation.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A generation of monsters" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "괴물 세대" } }
      }
    },
    "content.career-wind.v1.monster_generation.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Top prospects are everywhere this year. The rivals are tougher, but surviving it earns a larger inheritance." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "전국에 물건들이 쏟아진 해입니다. 라이벌은 세지만, 이런 해를 버틴 계승 포인트 보상은 큽니다." } }
      }
    },
