      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A new glove folds softly toward the palm from the start—the exact angle I closed hundreds of times in my last life." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "새 글러브가 처음부터 손바닥 안쪽으로 부드럽게 접힌다. 지난 삶에서 수백 번 닫았던 바로 그 각도다." } }
      }
    },
    "content.relationship.evt-glove-worn.choice.listen.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Follow the path the glove already takes" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "글러브가 접히는 길을 그대로 따른다" } }
      }
    },
    "content.relationship.evt-glove-worn.choice.listen.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Let body memory shorten the time needed to break in new leather." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "몸의 기억을 받아들여 새 장비에 적응할 시간을 줄인다" } }
      }
    },
    "content.relationship.evt-glove-worn.choice.explain.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Write today’s date inside the glove" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "가죽 안쪽에 오늘 날짜를 적는다" } }
      }
    },
    "content.relationship.evt-glove-worn.choice.explain.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Mark a boundary between an object from the old life and this beginning." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지난 삶의 물건과 이번 삶의 시작을 구분할 표식을 남긴다" } }
      }
    },
    "content.relationship.evt-glove-worn.choice.challenge.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Break it in deliberately the other way" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "일부러 반대 방향으로 다시 길들인다" } }
      }
    },
    "content.relationship.evt-glove-worn.choice.challenge.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Leave the fixed feeling behind, along with its familiar catch." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "정해진 감각을 벗어나지만 익숙한 포구감도 포기한다" } }
      }
    },
    "content.relationship.evt-undrafted-deja.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The moment the broadcast turns on, the air from the room where my name was never called returns. The first selection has not begun." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "중계 화면이 켜지자 이름이 끝내 불리지 않았던 방의 공기가 먼저 돌아왔다. 아직 첫 순서도 시작하지 않았다." } }
      }
    },
    "content.relationship.evt-undrafted-deja.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The moment the broadcast turns on, the air from the room where my name was never called returns. The first selection has not begun." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "중계 화면이 켜지자 이름이 끝내 불리지 않았던 방의 공기가 먼저 돌아왔다. 아직 첫 순서도 시작하지 않았다." } }
      }
    },
    "content.relationship.evt-undrafted-deja.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The moment the broadcast turns on, the air from the room where my name was never called returns. The first selection has not begun." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "중계 화면이 켜지자 이름이 끝내 불리지 않았던 방의 공기가 먼저 돌아왔다. 아직 첫 순서도 시작하지 않았다." } }
      }
    },
    "content.relationship.evt-undrafted-deja.choice.listen.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Take three breaths and watch the first selection" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "숨을 세 번 고르고 첫 순서를 지켜본다" } }
      }
    },
    "content.relationship.evt-undrafted-deja.choice.listen.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep the old ending from swallowing every name in the present." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "과거의 결말이 현재의 모든 이름을 삼키지 않게 한다" } }
      }
    },
    "content.relationship.evt-undrafted-deja.choice.explain.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Ask the family to open the window" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "가족에게 잠시 창문을 열어 달라고 한다" } }
      }
    },
    "content.relationship.evt-undrafted-deja.choice.explain.detail" : {
