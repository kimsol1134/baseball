    ,"content.weekly-task.pro_weeks_advanced.next-action" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Advance one week in your pro career." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "프로에서 한 주를 보내면 됩니다." } } } }
    ,"content.pledge.get-drafted.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hear your name called in the draft." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "드래프트에서 이름이 불린다." } } } }
    ,"content.pledge.strikeout-master.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Record 5 career strikeouts in games you pitch directly." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "직접 등판 통산 5탈삼진을 만든다." } } } }
    ,"content.pledge.clean-games.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Finish four directly pitched games without allowing a run." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "직접 던진 경기에서 무실점을 네 번 만든다." } } } }
    ,"content.pledge.iron-control.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pitch at least four games and record 4 career strikeouts without a walk." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "직접 등판 4경기 이상, 볼넷 없이 통산 4탈삼진을 만든다." } } } }
    ,"content.pledge.healthy-finish.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pitch four official high-school games and finish with fatigue at 78 or lower and no arm warning." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "고교 공식 경기 네 번을 치르고 피로를 78 이하로 남긴 채 팔 경고 없이 완주한다." } } } }
    ,"content.pledge.awakening-three.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose three awakenings from three different strategy families." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "각성 세 번을 고르고 서로 다른 전략 계열 세 가지를 모은다." } } } }
    ,"content.pledge.fan-sixty.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Raise fan interest to 25 or higher." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "팬 관심을 25 이상으로 올린다." } } } }
    ,"content.pledge.evaluation-sixty-five.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Earn a draft evaluation of 64 or higher." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "드래프트 평가 64점 이상을 받는다." } } } }
    ,"content.pledge.evaluation-seventy-five.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Earn a draft evaluation of 67 or higher." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "드래프트 평가 67점 이상을 받는다." } } } }
    ,"content.pledge.iron-control-five.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pitch at least four games and record 6 career strikeouts without a walk." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "직접 등판 4경기 이상, 볼넷 없이 통산 6탈삼진을 만든다." } } } }
    ,"content.pledge.rival-three-strikeouts.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Strike out your rival three times over your high-school career." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "고교 3년 동안 숙적을 세 번 삼진으로 잡는다." } } } }
    ,"content.pledge.relationship-sixty-five.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Raise trust with your manager, catcher, or rival to 69 or higher." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "감독·포수·숙적 중 한 관계를 69 이상으로 만든다." } } } }
    ,"content.pledge.legacy-strikeout-master.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Record 40 strikeouts directly over three years." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "3년 동안 직접 잡는 탈삼진 40개." } } } }
    ,"content.pledge.legacy-clean-games.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Finish two directly pitched games without allowing a run." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "직접 던진 경기에서 무실점을 두 번 만든다." } } } }
    ,"content.pledge.legacy-get-drafted.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hear your name called in the draft." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "드래프트에서 이름이 불린다." } } } }
    ,"content.pledge.legacy-iron-control.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Finish the season with 8 walks or fewer after at least four games." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "시즌을 볼넷 8개 이하로 완주한다(4경기 이상)." } } } }

    ,"content.player-heart.injury-recovery.mood" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Trying to Pitch Again" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "다시 던지기 위해" } } } }
    ,"content.player-heart.injury-recovery.words" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Please don't rush me right now. I want to come back right and pitch for a long time." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "지금은 서두르지 말아 줘요. 제대로 돌아와서 오래 던지고 싶어요." } } } }
    ,"content.player-heart.arm-warning.mood" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A Signal from My Arm" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "팔이 보내는 신호" } } } }
    ,"content.player-heart.arm-warning.words" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Today, I need you to watch my arm before the ball. I want us to stand together in the next game too." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "오늘은 공보다 내 팔을 먼저 봐 줬으면 해요. 다음 경기에도 함께 서고 싶어요." } } } }
    ,"content.player-heart.fatigue-warning.mood" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Running a Little Tired" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "조금 지친 마음" } } } }
    ,"content.player-heart.fatigue-warning.words" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "I'm a little tired. If you help choose when I rest, I can find my strength again." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "조금 지쳤어요. 쉬는 날까지 같이 골라 주면 다시 힘을 낼 수 있어요." } } } }
    ,"content.player-heart.chapter-review.mood" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Looking Back on a Chapter" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "한 시기를 지나며" } } } }
    ,"content.player-heart.chapter-review.words" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Take a moment to look back at how far I've come. I want us to find the next answer together too." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "여기까지 온 나를 한번 돌아봐 줘요. 다음 이야기에서도 함께 답을 찾고 싶어요." } } } }
    ,"content.player-heart.awakening.mood" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On the Verge of Change" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "달라지기 직전" } } } }
    ,"content.player-heart.awakening.words" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "More than which pitch I gain, help me choose what kind of pitcher I become." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "어떤 공을 갖게 될지보다, 어떤 투수가 될지 같이 골라 줘요." } } } }
    ,"content.player-heart.draft.mood" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for My Name" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이름을 기다리며" } } } }
    ,"content.player-heart.draft.words" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Now I wait for my name to be called. Whatever happens, remember the three years we spent together." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이제 내 이름이 불릴 차례를 기다려요. 어떤 결과여도 우리가 보낸 3년은 기억해 줘요." } } } }
    ,"content.player-heart.legacy-drafted.mood" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Facing a New Uniform" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "새 유니폼 앞에서" } } } }
    ,"content.player-heart.legacy-drafted.words" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "They called my name. I'll take our three years with me and see how far I can go." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "내 이름이 불렸어요. 우리가 보낸 3년까지 데리고 더 멀리 가 볼게요." } } } }
    ,"content.player-heart.legacy-undrafted.mood" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "At the End of Three Years" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "3년을 마치며" } } } }
    ,"content.player-heart.legacy-undrafted.words" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The result hurts. But please don't call the three years I lived a failure too." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "결과가 아프긴 해요. 그래도 내가 보낸 3년까지 실패로 부르지는 말아 줘요." } } } }
    ,"content.player-heart.completed-drafted.mood" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Facing a New Uniform" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "새 유니폼 앞에서" } } } }
    ,"content.player-heart.completed-drafted.words" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "They called my name. I'll take our three years with me and see how far I can go." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "내 이름이 불렸어요. 우리가 보낸 3년까지 데리고 더 멀리 가 볼게요." } } } }
    ,"content.player-heart.completed-undrafted.mood" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "At the End of Three Years" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "3년을 마치며" } } } }
    ,"content.player-heart.completed-undrafted.words" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The result hurts. But please don't call the three years I lived a failure too." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "결과가 아프긴 해요. 그래도 내가 보낸 3년까지 실패로 부르지는 말아 줘요." } } } }

    ,"content.player-legacy.title.signature" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Pitcher Who Left His Own Game Behind" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "자기 공을 남긴 투수" } } } }
    ,"content.player-legacy.title.drafted" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Pitcher We Raised All the Way" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "끝까지 키워 낸 투수" } } } }
    ,"content.player-legacy.title.pledge" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Pitcher Who Kept a Promise" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "자기 목표를 지킨 투수" } } } }
    ,"content.player-legacy.title.scoreless" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Pitcher Who Protected Home" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "끝까지 홈을 지킨 투수" } } } }
    ,"content.player-legacy.title.strikeouts" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Pitcher Who Believed in the Strikeout" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "삼진을 믿었던 투수" } } } }
    ,"content.player-legacy.title.together" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The Pitcher Who Shared Three Years with Us" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "함께 3년을 보낸 투수" } } } }
    ,"content.player-legacy.opening.drafted" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "When they called my name, I first thought of the pitches we built one stitch at a time." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "내 이름이 불릴 때, 제일 먼저 우리가 한 땀씩 키운 공이 떠올랐어요." } } } }
    ,"content.player-legacy.opening.undrafted-signature" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The pros never called, but %@. That time doesn't disappear." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "프로의 부름은 없었지만, %@ 그 시간까지 사라지는 건 아니죠." } } } }
    ,"content.player-legacy.opening.undrafted" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The pros never called, but the three years I lived don't disappear." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "프로의 부름은 없었지만, 내가 보낸 3년까지 사라지는 건 아니죠." } } } }
    ,"content.player-legacy.closing.drafted-signature" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "I'll carry '%@' with me to a bigger mound." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "우리가 만든 ‘%@’과 함께 더 큰 마운드로 가 볼게요." } } } }
    ,"content.player-legacy.closing.undrafted-signature" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "I hope '%@' reaches the beginning of another mound someday." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "‘%@’이 언젠가 다른 마운드의 시작에 닿기를 바라요." } } } }
    ,"content.player-legacy.closing.memory-fiery" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The heart that never backed down and the memories I chose will carry into the next player's first pitch." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "마지막까지 물러서지 않았던 마음과 내가 고른 기억은 다음 선수의 첫 공에 이어질 거예요." } } } }
    ,"content.player-legacy.closing.memory-steady" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The quiet days I built and the memories I chose will carry into the next player's first pitch." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "말없이 오래 쌓은 하루들과 내가 고른 기억은 다음 선수의 첫 공에 이어질 거예요." } } } }
    ,"content.player-legacy.closing.memory-analyst" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Every reason behind my choices and the memories I chose will carry into the next player's first pitch." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "매번 그 공을 고른 이유와 내가 고른 기억은 다음 선수의 첫 공에 이어질 거예요." } } } }
    ,"content.player-legacy.closing.memory-adaptable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The answers I found for each situation and the memories I chose will carry into the next player's first pitch." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "상황마다 찾은 답과 내가 고른 기억은 다음 선수의 첫 공에 이어질 거예요." } } } }
    ,"content.player-legacy.closing.memory-default" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The memories I chose will carry into the next player's first pitch." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "내가 고른 기억은 다음 선수의 첫 공에 이어질 거예요." } } } }
    ,"content.player-legacy.closing.plain-fiery" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Please remember the heart that never backed down." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "마지막까지 물러서지 않았던 마음만은 오래 기억해 주세요." } } } }
    ,"content.player-legacy.closing.plain-steady" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "I hope the quiet days I built can strengthen someone's beginning." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "말없이 오래 쌓은 하루들이 누군가의 시작에 힘이 되면 좋겠어요." } } } }
    ,"content.player-legacy.closing.plain-analyst" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Remember not only the result, but why I chose each pitch." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "결과뿐 아니라, 내가 매번 그 공을 고른 이유도 기억해 주세요." } } } }
    ,"content.player-legacy.closing.plain-adaptable" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "I hope my record helps someone else find an answer of their own." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "내 기록이 다른 누군가에게 자기만의 답을 찾는 힌트가 되면 좋겠어요." } } } }
    ,"content.player-legacy.closing.plain-default" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "I hope the record I leave can strengthen the beginning of another mound." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "내가 남긴 기록이 언젠가 다른 마운드의 시작에 힘이 되면 좋겠어요." } } } }
    ,"content.player-legacy.moment.drafted" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The day %1$@ called %2$@'s name" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "%1$@이 %2$@의 이름을 불렀던 날" } } } }
    ,"content.player-legacy.moment.undrafted" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The day the final pitch was thrown at %@" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@에서 마지막 공을 던진 날" } } } }
