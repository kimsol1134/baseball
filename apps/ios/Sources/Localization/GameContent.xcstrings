    "content.relationship.evt-arm-care.choice.challenge.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Throw through it" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "참고 던진다" } }
      }
    },
    "content.relationship.evt-arm-care.choice.challenge.detail" : {
      "localizations" : {
