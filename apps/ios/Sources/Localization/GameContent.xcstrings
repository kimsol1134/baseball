    "content.chapter-goal.scout-attention.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A notebook in the back of the stands is waiting for %lld strikeouts this stretch." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "관중석 뒤편의 수첩이 이번 이야기 탈삼진 %lld개를 기다립니다." } }
      }
