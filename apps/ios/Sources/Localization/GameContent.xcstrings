    "content.chapter-review.verdict.no-official-games.sentence" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This chapter unfolded away from the mound. Next, it is time to let the ball do the talking." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "마운드 밖에서 보낸 시기였습니다. 다음 무대는 공으로 말할 차례입니다." } }
      }
    },
    "content.chapter-review.verdict.process-over-numbers.sentence" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The process mattered more than the numbers this time. Your mechanics do not lie." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "숫자보다 과정이 남은 시기입니다. 폼은 거짓말하지 않습니다." } }
      }
    },
    "content.chapter-review.verdict.strikeouts-outpace-walks.sentence" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Strikeouts outpaced walks. Your stuff is starting to make noise." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "삼진이 볼넷을 압도했습니다. 공이 소문을 내기 시작합니다." } }
      }
    },
    "content.chapter-review.verdict.walkless-strikeouts.sentence" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You made it through without a walk. Scouts underlined your name in their notebooks." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "볼넷 없이 지나온 시기 — 스카우트 수첩에 밑줄이 그어졌습니다." } }
