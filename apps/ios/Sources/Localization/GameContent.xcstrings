    "content.event.evt-bullpen-rival.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A teammate competing for the starting spot asks to see your new breaking-ball grip." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "선발 자리를 다투는 동료가 새 변화구 그립을 보여 달라고 합니다." } }
      }
    },
    "content.event.evt-scout-question.title" : {
