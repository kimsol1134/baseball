        "en" : { "stringUnit" : { "state" : "translated", "value" : "What the Body Knows First" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "몸이 먼저 아는 것" } }
      }
    },
    "content.event.evt-first-awakening.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A motion you repeated in training comes naturally in the game." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "최근 훈련에서 반복한 동작이 경기에서도 자연스럽게 나옵니다." } }
