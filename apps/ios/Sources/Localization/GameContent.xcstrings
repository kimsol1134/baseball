        "ko" : { "stringUnit" : { "state" : "translated", "value" : "세 경기 연속 패배 뒤 선수들이 자율 훈련 시간을 두고 다툽니다." } }
      }
    },
    "content.event.evt-bullpen-rival.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A Teammate in the Race" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "같은 팀의 경쟁자" } }
      }
