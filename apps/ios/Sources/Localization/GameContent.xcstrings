    },
    "content.event.evt-coach-last-advice.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your coach asks you to choose the final workout before the draft." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "감독이 드래프트 전 마지막 훈련 하나를 직접 고르라고 합니다." } }
      }
    },
    "content.event.evt-rival-final.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Last Rematch" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "마지막 재대결" } }
      }
    },
    "content.event.evt-rival-final.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your rival points to the same spot as last game when he steps into the box." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "라이벌이 타석에 들어서며 지난 경기와 같은 코스를 가리킵니다." } }
      }
    },
    "content.event.evt-draft-projection.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Draft Projection" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "예상 순위" } }
      }
    },
    "content.event.evt-draft-projection.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The media projection and the school report differ by two rounds." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "언론 예상 순위와 학교가 들은 구단 평가가 두 라운드나 차이 납니다." } }
      }
    },
    "content.event.evt-undrafted-room.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Room Where No Name Was Called" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이름이 불리지 않은 방" } }
      }
    },
    "content.event.evt-undrafted-room.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "After the final round, you spread out three years of records again." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "마지막 라운드가 끝난 뒤 세 해의 기록을 다시 펼칩니다." } }
      }
    },
    "content.event.evt-drafted-call.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Team Calls" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "구단의 전화" } }
      }
    },
    "content.event.evt-drafted-call.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The team that drafted you calls with a plan for your first season of training." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지명 구단 담당자가 전화를 걸어 입단 뒤 첫 시즌 훈련 계획을 설명합니다." } }
      }
    },
    "content.event.evt-scorebook-close.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Last Scorebook" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "마지막 스코어북" } }
      }
    },
    "content.event.evt-scorebook-close.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You mark the best and hardest games from your three-year career." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "세 해 동안 가장 좋았던 경기와 가장 힘들었던 경기에 표시를 남깁니다." } }
      }
    },
    "content.event.evt-deja-vu-mound.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A Familiar Mound" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "처음 밟는데 익숙한 마운드" } }
      }
    },
    "content.event.evt-deja-vu-mound.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "It is your first time on this mound, but the dirt and the angle under your feet feel known." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "처음 오르는 마운드인데 흙의 단단함과 발끝의 각도가 이미 알던 것 같습니다." } }
      }
    },
    "content.event.evt-known-coach.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A Familiar Coach" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "낯익은 감독" } }
      }
    },
    "content.event.evt-known-coach.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your coach's mannerisms feel familiar, though you have never met." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "감독의 말버릇과 손짓이 어디선가 본 것 같습니다. 만난 적은 없습니다." } }
      }
    },
    "content.event.evt-body-remembers.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A Grip the Body Remembers" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "몸이 먼저 아는 그립" } }
      }
    },
    "content.event.evt-body-remembers.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A grip you never learned settles into your hand. You try it, and it really breaks." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "배운 적 없는 그립이 손에 저절로 잡힙니다. 던져 보니 실제로 휩니다." } }
      }
    },
    "content.event.evt-rival-deja-vu.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A Rival with a Sense of Déjà Vu" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "라이벌의 기시감" } }
      }
    },
    "content.event.evt-rival-deja-vu.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your rival studies you from the box and asks whether you have faced each other before." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "라이벌이 타석에서 당신을 오래 봅니다. “우리 어디서 붙은 적 있나?”" } }
      }
    },
    "content.event.evt-memory-ache.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Memory Pain" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "기억의 통증" } }
      }
    },
    "content.event.evt-memory-ache.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "It is the week your arm gave out last time. Nothing hurts, but you keep noticing that spot." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지난번에 팔을 다쳤던 그 주차입니다. 아프지 않은데 그 자리가 신경 쓰입니다." } }
      }
    },
    "content.event.evt-second-summer.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Another Third-Year Summer" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다시 맞는 3학년 여름" } }
      }
    },
    "content.event.evt-second-summer.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Same season, same tournament. This time you know what is coming." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "같은 계절, 같은 대회. 이번에는 결과를 알고 시작합니다." } }
      }
    },
    "content.event.evt-remembered-pitch.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Sign for That Corner" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "그 코스의 사인" } }
      }
    },
    "content.event.evt-remembered-pitch.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The catcher calls the exact spot where you gave up a home run in your last life." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지난 삶에서 홈런을 맞았던 바로 그 코스에 사인이 나옵니다. 포수는 아무것도 모릅니다." } }
      }
    },
    "content.event.evt-lost-teammate.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Teammate Who Quit" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "그만둔 동료" } }
      }
    },
    "content.event.evt-lost-teammate.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You hear that a teammate who threw beside you to the end last life has quit baseball this time." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지난 삶에서 끝까지 함께 던졌던 동료가, 이번 삶에서는 야구를 그만뒀다는 소식을 듣습니다." } }
      }
    },
    "content.event.evt-future-news.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "News You Already Know" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "결말을 아는 뉴스" } }
      }
    },
    "content.event.evt-future-news.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The radio names this year’s title favorite. It sounds exactly like a book whose ending you remember." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "라디오가 올해의 우승 후보를 읊습니다. 지난 삶과 한 글자도 다르지 않아, 결말을 아는 책 같습니다." } }
      }
    },
    "content.event.evt-old-nickname.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "An Old-Life Nickname" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지난 삶의 별명" } }
      }
    },
    "content.event.evt-old-nickname.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A catcher you just met calls you by a nickname that does not exist in this life yet." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "처음 만난 상대 포수가 당신을 지난 삶의 별명으로 부릅니다. 이번 삶에는 아직 없는 이름입니다." } }
      }
    },
    "content.event.evt-glove-worn.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A Broken-In New Glove" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "길들여진 새 글러브" } }
      }
    },
    "content.event.evt-glove-worn.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The new glove is soft where your last life wore it in, folding at the angle your hand remembers." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "새 글러브인데 지난 삶에서 길들인 자리부터 부드럽습니다. 손이 먼저 접던 각도로 접힙니다." } }
      }
    },
    "content.event.evt-undrafted-deja.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Room Feels Familiar" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "그 방의 기시감" } }
      }
    },
    "content.event.evt-undrafted-deja.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "When the draft broadcast starts, the air of the room where your name went uncalled returns first." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "드래프트 중계를 트는 순간, 이름이 불리지 않은 채 끝났던 그 방의 공기가 먼저 돌아옵니다." } }
      }
    },
    "content.event.evt-arm-care.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Arm Warning" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "팔 상태 경고" } }
      }
    },
    "content.event.evt-arm-care.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your arm feels heavier than usual after recent outings. The trainer asks what you want to do today." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "최근 등판 뒤 팔이 평소보다 무겁습니다. 트레이너가 오늘 어떻게 할지 묻습니다." } }
      }
    }
,
    "content.relationship.evt-arm-care.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Your arm looks heavy. …You will throw anyway, even if I tell you, right?”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“팔이 무거워 보이는데. …말해 줘도 어차피 던질 거지?”" } }
      }
    },
    "content.relationship.evt-arm-care.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Your throwing arm looks heavy after those outings. What do you want to do today?”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“최근 등판 뒤로 공을 놓는 팔이 무거워 보여. 오늘은 어떻게 할까?”" } }
      }
    },
    "content.relationship.evt-arm-care.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“%@, your arm is heavy. I know you push through, so I am asking first: what do we do today?”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“%@, 팔이 무거워. 참는 편인 거 아니까 내가 먼저 말한다. 오늘은 어떻게 할까?”" } }
      }
    },
    "content.relationship.evt-battery-dinner.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Honestly, I cannot even catch your breaking ball. This is not a battery; we are playing separate games.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“네 변화구, 솔직히 나도 못 받겠어. 이건 배터리가 아니라 각자 야구잖아.”" } }
      }
    },
    "content.relationship.evt-battery-dinner.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Honestly, sometimes I am scared because I do not know where your breaking ball will go.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“솔직히 네 변화구가 어디로 올지 몰라서 겁날 때가 있어.”" } }
      }
    },
    "content.relationship.evt-battery-dinner.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“I could catch your breaking ball with my eyes closed now, %@. I can see where it will land the instant it leaves your hand.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“이제 %@ 변화구는 눈 감고도 받아. 손 떠나는 순간 어디 떨어질지 보이거든.”" } }
      }
    },
    "content.relationship.evt-body-remembers.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A grip you never learned settles into your hand. You try it, and it really breaks." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "배운 적 없는 그립이 손에 저절로 잡힌다. 던져 보니 정말로 휜다." } }
      }
    },
    "content.relationship.evt-body-remembers.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A grip you never learned settles into your hand. You try it, and it really breaks." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "배운 적 없는 그립이 손에 저절로 잡힌다. 던져 보니 정말로 휜다." } }
      }
    },
    "content.relationship.evt-body-remembers.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A grip you never learned settles into your hand. You try it, and it really breaks." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "배운 적 없는 그립이 손에 저절로 잡힌다. 던져 보니 정말로 휜다." } }
      }
    },
    "content.relationship.evt-bullpen-rival.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“That grip of yours… You do not have to show me. There is only one starting spot anyway.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“네 그 그립… 뭐, 안 보여줘도 되고. 어차피 자리는 하나니까.”" } }
      }
    },
    "content.relationship.evt-bullpen-rival.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“That new breaking-ball grip… Will you show me once? We are competing for one spot, but I still want to learn.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“네 새 변화구 그립… 한 번만 보여줄래? 선발 자리는 서로 뺏는 사이지만, 그래도 배우고 싶어서.”" } }
      }
    },
    "content.relationship.evt-bullpen-rival.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“%@, show me that grip. I will teach you my slider in return. We both have to improve if this team is going to survive.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“%@, 그 그립 좀 보여줘. 대신 내 슬라이더 쥐는 법 알려줄게. 서로 늘어야 팀이 산다.”" } }
      }
    },
    "content.relationship.evt-captain-talk.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Can you take the long innings next game? I am asking because I do not know where you are right now.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“다음 경기 긴 이닝… 맡을 수 있겠어? 요즘 네가 어떤지 잘 몰라서 묻는다.”" } }
      }
    },
    "content.relationship.evt-captain-talk.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Can you take the long innings next game? Say so if it is too much. That is better for the team.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“다음 경기, 긴 이닝 맡아 줄 수 있어? 무리면 무리라고 말해. 그게 팀엔 더 나아.”" } }
      }
    },
    "content.relationship.evt-captain-talk.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“We need you to go deep next game, %@. Everyone is counting on you.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“다음 경기는 %@가 길게 가 줘야 해. 다들 그렇게 생각하고 있어.”" } }
      }
    },
    "content.relationship.evt-catcher-doubt.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“If you are going to shake off every sign, call the whole game yourself. …Why am I even behind the plate?”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“사인을 그렇게 거절할 거면 마운드에서 혼자 다 정해. …난 뭐 하러 앉아 있어?”" } }
      }
    },
    "content.relationship.evt-catcher-doubt.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“You keep shaking off my signs. Am I missing something?”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“요즘 내 사인을 자꾸 거절하잖아. 내가 못 본 게 있어?”" } }
      }
    },
    "content.relationship.evt-catcher-doubt.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“The pitches you shake off have been better lately, %@. I want to see what you are seeing.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“요즘 %@가 고개 젓는 공이 더 좋더라. 네가 보는 걸 나도 보고 싶어.”" } }
      }
    },
    "content.relationship.evt-catcher-sign.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“That is three crossed-up signs. …Why bother working as a battery if you are going to change everything?”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“또 사인이 세 번 바뀌었어. …이럴 거면 왜 나랑 배터리를 맞춰?”" } }
      }
    },
    "content.relationship.evt-catcher-sign.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“We changed signs three times today. What did I miss?”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“오늘 사인이 세 번이나 바뀌었어. 내가 놓친 게 뭐였어?”" } }
      }
    },
    "content.relationship.evt-catcher-sign.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“All three changes worked today. I know your pitches better than anyone now, %@.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“세 번 바꾼 거, 오늘은 다 맞았어. %@ 공은 이제 내가 제일 잘 알아.”" } }
      }
    },
    "content.relationship.evt-coach-bench.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“You are sitting today. I cannot trust a pitcher who hides how he feels.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“오늘은 뺀다. 몸 상태를 나한테 숨기는 선수는 더 오래 못 믿어.”" } }
      }
    },
    "content.relationship.evt-coach-bench.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“You are skipping this outing. Lately your arm has been a step behind the rest of you.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“이번 등판은 쉰다. 요즘은 팔이 몸보다 늦게 따라온다.”" } }
      }
    },
    "content.relationship.evt-coach-bench.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Take a day, %@. If I send you out knowing you are pushing too hard, that is on me.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“하루 쉬자. %@가 무리하는 걸 알면서 내보내면, 그건 내 잘못이 되니까.”" } }
      }
    },
    "content.relationship.evt-coach-last-advice.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“This is the last workout. …Do I still have to choose for you? If you cannot choose for yourself, pro ball will only get harder.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“마지막 훈련이다. …아직도 내가 정해 줘야 하나. 스스로 못 고르면 프로에선 더 헤맨다.”" } }
      }
    },
    "content.relationship.evt-coach-last-advice.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“You choose the last workout. What are you still missing?”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“마지막 훈련은 네가 정해라. 지금 가장 부족한 게 뭐지?”" } }
      }
    },
    "content.relationship.evt-coach-last-advice.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“The last workout is yours, %@. I have watched you for three years. It is time I trusted your judgment.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“마지막 훈련은 %@ 너한테 맡긴다. 3년을 봤으니, 이제 네 판단을 믿어 볼 때도 됐지.”" } }
      }
    },
    "content.relationship.evt-coach-role.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Starter is a long way off. Start in the bullpen. …You could throw more pitches instead of asking why.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“선발은 아직 이르다. 불펜부터 시작해. …이유를 따질 시간에 공이나 더 던져 봐.”" } }
      }
    },
    "content.relationship.evt-coach-role.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“You will start the next tournament in the bullpen. I need you for the late innings.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“다음 대회는 불펜에서 시작한다. 경기 후반을 맡아 줘.”" } }
      }
    },
    "content.relationship.evt-coach-role.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“%@. You are closing out the late innings this time. I do not give the final inning to just anyone.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“%@. 이번엔 네가 경기 후반을 닫아 줘. 마지막 이닝은 아무한테나 안 맡긴다.”" } }
      }
    },
    "content.relationship.evt-deja-vu-mound.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "It is my first time on this mound. Yet my body already knows the angle my toes should dig into the dirt." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "처음 오르는 마운드다. 그런데 발끝이 흙을 파는 각도까지 이미 몸이 알고 있다." } }
      }
    },
    "content.relationship.evt-deja-vu-mound.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "It is my first time on this mound. Yet my body already knows the angle my toes should dig into the dirt." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "처음 오르는 마운드다. 그런데 발끝이 흙을 파는 각도까지 이미 몸이 알고 있다." } }
      }
    },
    "content.relationship.evt-deja-vu-mound.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "It is my first time on this mound. Yet my body already knows the angle my toes should dig into the dirt." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "처음 오르는 마운드다. 그런데 발끝이 흙을 파는 각도까지 이미 몸이 알고 있다." } }
      }
    },
    "content.relationship.evt-exam-week.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“The exam and road trip overlap. If all you do is hold a ball, your options will shrink later.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“시험이랑 원정이 겹쳤지. 공만 잡고 있으면 나중에 갈 데가 좁아진다.”" } }
      }
    },
    "content.relationship.evt-exam-week.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“The exam and road trip overlap. You need a few days with your books too. …Baseball will still be here.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“시험이랑 원정이 겹쳤지. 공만큼 책도 며칠은 잡아야 한다. …야구는 안 도망가.”" } }
      }
    },
    "content.relationship.evt-exam-week.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“%@, your exams overlap with the road trip. I know you will handle it, so I will keep this short: just a few days.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“%@, 시험이랑 원정이 겹쳤더라. 알아서 할 거 아니까 길게 말 안 한다. 며칠만.”" } }
      }
    },
    "content.relationship.evt-fan-letter.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“I saw you lose last time. I still liked that slow pitch.” It was a short letter." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“저번에 진 거 봤어요. 그래도 그 느린 공은 좋았어요.” 짧은 편지 한 장이다." } }
      }
    },
    "content.relationship.evt-fan-letter.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“I love that slow pitch you throw, %@. Please throw it again next game!” A drawing sat beneath the crooked handwriting." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“%@ 선수님이 던지는 그 느린 공이 제일 좋아요. 다음 경기에도 꼭 던져 주세요!” 삐뚤빼뚤한 글씨 밑에 그림도 그려져 있다." } }
      }
    },
    "content.relationship.evt-fan-letter.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“I cheer the loudest when you throw that slow pitch. You will throw it again, right?” Three letters arrived." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“그 느린 공 던질 때 제가 제일 크게 소리쳐요. 다음에도 던져 주실 거죠?” 편지가 세 장이나 왔다." } }
      }
    },
    "content.relationship.evt-known-coach.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your coach’s mannerisms feel familiar. You almost know what he will say next, but you have never met." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "감독의 말버릇이 낯익다. 다음에 무슨 말을 할지 알 것 같은데, 만난 적은 없다." } }
      }
    },
    "content.relationship.evt-known-coach.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your coach’s mannerisms feel familiar. You almost know what he will say next, but you have never met." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "감독의 말버릇이 낯익다. 다음에 무슨 말을 할지 알 것 같은데, 만난 적은 없다." } }
      }
    },
    "content.relationship.evt-known-coach.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your coach’s mannerisms feel familiar. You almost know what he will say next, but you have never met." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "감독의 말버릇이 낯익다. 다음에 무슨 말을 할지 알 것 같은데, 만난 적은 없다." } }
      }
    },
    "content.relationship.evt-loss-interview.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Was that last pitch a mistake?” The recorder was still running." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“마지막 그 공, 실투였습니까?” 녹음기가 아직 돌아가고 있다." } }
      }
    },
    "content.relationship.evt-loss-interview.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Why did you choose that pitch to the final batter?” The recorder was still running." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“마지막 타자에게 그 공을 고른 이유가 있었나요?” 녹음기가 아직 돌아가고 있다." } }
      }
    },
    "content.relationship.evt-loss-interview.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“%@, you meant to throw that last pitch, right? I waited because I wanted to understand the call.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“%@ 선수, 마지막 그 공 노리고 던진 거죠? 그 판단이 궁금해서 기다렸습니다.”" } }
      }
    },
    "content.relationship.evt-memory-ache.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This is the week my arm gave out last time. Nothing hurts, but I cannot stop noticing that spot." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지난번에 팔이 나갔던 바로 그 주차다. 아프지 않은데 그 자리가 계속 신경 쓰인다." } }
      }
    },
    "content.relationship.evt-memory-ache.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This is the week my arm gave out last time. Nothing hurts, but I cannot stop noticing that spot." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지난번에 팔이 나갔던 바로 그 주차다. 아프지 않은데 그 자리가 계속 신경 쓰인다." } }
      }
    },
    "content.relationship.evt-memory-ache.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This is the week my arm gave out last time. Nothing hurts, but I cannot stop noticing that spot." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "지난번에 팔이 나갔던 바로 그 주차다. 아프지 않은데 그 자리가 계속 신경 쓰인다." } }
      }
    },
    "content.relationship.evt-national-stage.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“The cameras are on you from the bullpen today. If that bothers you, that is how it is.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“오늘 불펜부터 카메라 붙는다. 부담되면 어쩔 수 없고.”" } }
      }
    },
    "content.relationship.evt-national-stage.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“We will get some shots from the bullpen. Throw like you always do. …That is the hardest thing, is it not?”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“오늘 불펜부터 그림 좀 담을게. 평소대로 던져. …평소대로가 제일 어렵지?”" } }
      }
    },
    "content.relationship.evt-national-stage.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Today’s broadcast is built around you, %@. Just throw like you always do; the story will take care of itself.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“오늘은 %@ 중심으로 간다. 평소대로만 하면 그림은 알아서 나와.”" } }
      }
    },
    "content.relationship.evt-new-catcher.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“We used these signs at my old school. …If you are going to call everything anyway, use whatever.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“전 학교에서는 이 사인을 썼어. …어차피 네가 다 정할 거면 아무거나 해도 되고.”" } }
      }
    },
    "content.relationship.evt-new-catcher.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“We used these signs at my old school. Want to try them next game?”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“전 학교에서는 이 사인을 썼어. 우리도 다음 경기부터 바꿔 볼래?”" } }
      }
    },
    "content.relationship.evt-new-catcher.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“The old-school signs still feel natural. But let us use what makes you comfortable, %@. I can adjust.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“전 학교 사인이 손에 더 붙어. 근데 %@가 편한 쪽으로 가자. 나는 맞출 수 있어.”" } }
      }
    },
    "content.relationship.evt-parent-call.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“You have not called lately. …What are you thinking after the draft?”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“요즘 연락이 없더라. …드래프트 끝나고는 어떻게 할 생각이니.”" } }
      }
    },
    "content.relationship.evt-parent-call.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“You are going to keep playing after the draft, right? …You do not have to answer yet. Are you eating properly?”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“드래프트 끝나고도 계속할 거지? …아니, 대답은 천천히 해도 돼. 밥은 챙겨 먹고 다니니.”" } }
      }
    },
    "content.relationship.evt-parent-call.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“I watched the game. You did well. …You will keep playing after the draft, right? Whatever you choose, eat properly.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“경기 봤다. 잘하더라. …드래프트 끝나고도 계속할 거지? 뭘 하든 밥은 챙겨 먹고.”" } }
      }
    },
    "content.relationship.evt-rival-deja-vu.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "He studies me from the box. “Have we faced each other somewhere before?”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "타석에 선 그가 오래 본다. “우리… 어디서 붙은 적 있나?”" } }
      }
    },
    "content.relationship.evt-rival-deja-vu.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "He studies me from the box. “Have we faced each other somewhere before?”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "타석에 선 그가 오래 본다. “우리… 어디서 붙은 적 있나?”" } }
      }
    },
    "content.relationship.evt-rival-deja-vu.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "He studies me from the box. “Have we faced each other somewhere before?”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "타석에 선 그가 오래 본다. “우리… 어디서 붙은 적 있나?”" } }
      }
    },
    "content.relationship.evt-rival-final.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "He smiles without looking at the catcher’s mitt. “You are throwing it there anyway. I know you.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "타석에 선 그가 포수 미트도 보지 않고 웃는다. “어차피 거기로 올 거잖아. 다 알아.”" } }
      }
    },
    "content.relationship.evt-rival-final.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "He points his bat at the same spot as last game. “Try that corner again.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "타석에 들어선 그가 지난 경기와 같은 코스를 배트 끝으로 가리킨다. “또 여기로 던져 봐.”" } }
      }
    },
    "content.relationship.evt-rival-final.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "He resets his grip and speaks quietly. “%@. This is the last one. Bring your best pitch. Then neither of us will forget it.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "타석에 들어선 그가 배트를 고쳐 쥐며 낮게 말한다. “%@. 마지막이네. 네 제일 좋은 공으로 와. 그래야 이겨도 져도 남지.”" } }
      }
    },
    "content.relationship.evt-rival-message.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Same first pitch again, right? …It is the only one you have.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“어차피 또 같은 초구겠지. …너 그거밖에 없잖아.”" } }
      }
    },
    "content.relationship.evt-rival-message.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Are you throwing the same first pitch next time?”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“다음에도 같은 초구를 던질 거야?”" } }
      }
    },
    "content.relationship.evt-rival-message.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Want me to guess your next first pitch, %@? …No. I would rather see it for myself.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“%@ 다음 초구, 뭐 던질지 맞혀 볼까. …아니다, 그건 직접 보는 게 낫지.”" } }
      }
    },
    "content.relationship.evt-rival-video.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Your high four-seam does not scare me anymore.” He sent a hitting clip with not a single swing-and-miss." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“네 높은 포심, 이제 안 무서워.” 헛스윙 하나 없는 타격 영상만 툭 보내왔다." } }
      }
    },
    "content.relationship.evt-rival-video.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“I have the timing on your high four-seam now.” A short hitting clip came with the message." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“높은 포심 타이밍, 이제 맞췄어.” 짧은 타격 영상이 함께 도착했다." } }
      }
    },
    "content.relationship.evt-rival-video.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“%@. I finally caught up to your high four-seam. …It took me three years to do it.” A smiley closed the clip." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“%@. 높은 포심, 드디어 맞췄어. …근데 이거 하나 맞추는 데 3년 걸렸다.” 영상 끝엔 웃는 표시가 붙어 있었다." } }
      }
    },
    "content.relationship.evt-school-record.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Six more strikeouts and it is a school record. …I am not trying to pressure you.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“선배, 여섯 개만 더 잡으면 학교 기록이래요. …아, 부담 드리려던 건 아니고요.”" } }
      }
    },
    "content.relationship.evt-school-record.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Six more strikeouts next game and you change the school record. …I want to watch it happen.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“선배, 다음 경기에서 여섯 개만 더 잡으면 학교 기록이래요. …저 그거 옆에서 보고 싶어요.”" } }
      }
    },
    "content.relationship.evt-school-record.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Six. That is all you need. I came to see it today.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“선배, 여섯 개예요. 저 오늘 그거 보려고 왔어요.”" } }
      }
    },
    "content.relationship.evt-scout-question.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“I watched that game last month. …What did you change afterward?”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“지난달 그 경기 봤다. …그 뒤로 뭘 바꿨나?”" } }
      }
    },
    "content.relationship.evt-scout-question.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“After that collapse last month, what did you change? …That is what I am most interested in.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“지난달 무너진 경기 다음에, 뭘 바꿨지? …바꾼 게 있다면 그게 제일 궁금해.”" } }
      }
    },
    "content.relationship.evt-scout-question.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“%@, you are clearly different since that game last month. I came to hear what changed.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“%@. 지난달 그 경기 뒤로 확실히 달라졌더라. 뭘 바꿨는지 듣고 싶어서 왔다.”" } }
      }
    },
    "content.relationship.evt-second-summer.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Same season, same tournament. This time I am standing here knowing what is coming." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "같은 계절, 같은 대회. 이번에는 무엇이 오는지 알고 서 있다." } }
      }
    },
    "content.relationship.evt-second-summer.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Same season, same tournament. This time I am standing here knowing what is coming." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "같은 계절, 같은 대회. 이번에는 무엇이 오는지 알고 서 있다." } }
      }
    },
    "content.relationship.evt-second-summer.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Same season, same tournament. This time I am standing here knowing what is coming." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "같은 계절, 같은 대회. 이번에는 무엇이 오는지 알고 서 있다." } }
      }
    },
    "content.relationship.evt-velocity-drop.quote.low" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“Your velocity is down for the second straight game. …If you will not listen, I will just keep the record.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“두 경기째 구속이 빠졌어. …말해도 안 들을 거면 기록만 남겨 둘게.”" } }
      }
    },
    "content.relationship.evt-velocity-drop.quote.mid" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“You are down 1.2 mph for the second straight game. Numbers do not lie. Your body is saying something.”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“두 경기째 구속이 2km/h 빠졌어. 숫자는 거짓말을 안 해. 몸이 뭔가 말하는 중이야.”" } }
      }
    },
    "content.relationship.evt-velocity-drop.quote.high" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "“1.2 mph in two straight games. I thought you would feel it before anyone else. How does it feel?”" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "“두 경기째 2km/h. 네가 먼저 느꼈을 거라 생각하는데, 어때?”" } }
      }
    }
,
    "content.relationship.evt-arm-care.choice.listen.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Take a short rest" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "짧은 휴식" } }
      }
    },
    "content.relationship.evt-arm-care.choice.listen.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Give the arm a break and sharply reduce fatigue and risk." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이번엔 팔을 쉬어 피로와 위험을 크게 던다" } }
