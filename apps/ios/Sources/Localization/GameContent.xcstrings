    ,"content.weekly-task.different_school_selected.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose a Different School" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "지난 선수와 다른 학교 고르기" } } } }
    ,"content.weekly-task.different_school_selected.next-action" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose a school different from your previous player's." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "지난 선수와 다른 학교를 고르면 됩니다." } } } }
    ,"content.weekly-task.sequence_mastery_triggered.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Win 3 Pitching Mind Games" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "수싸움 3회 성공하기" } } } }
    ,"content.weekly-task.sequence_mastery_triggered.next-action" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Read velocity and location changes to outthink the hitter." } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "구속 차와 코스 변화를 읽어 수싸움을 맞히면 됩니다." } } } }
