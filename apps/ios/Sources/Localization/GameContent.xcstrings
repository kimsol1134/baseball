    "content.important-game.game-loaded.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You need weak contact without giving up a walk." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "볼넷을 피하면서 약한 타구가 필요한 상황" } }
      }
    },
    "content.important-game.game-two-outs.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Runner on Second, Two Outs" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "2사 2루" } }
      }
    },
    "content.important-game.game-two-outs.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The inning comes down to this one hitter." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "한 타자에 이닝이 걸린 승부" } }
      }
    },
    "content.important-game.game-fatigue.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Fatigued Seventh" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "피로한 7회" } }
      }
    },
    "content.important-game.game-fatigue.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your fastball has lost a step in the seventh. Choose the pitch you can live with." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "직구가 느려진 7회, 어떤 공으로 버틸지 정해야 합니다." } }
      }
    },
    "content.important-game.game-scout.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Scout in the Stands" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "스카우트 관전" } }
      }
    },
    "content.important-game.game-scout.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your team is down a run, but the scout is watching whether you repeat the same location—not the score." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "팀은 한 점 뒤져 있지만, 스카우트는 점수가 아니라 같은 코스를 반복하는지 지켜봅니다." } }
      }
    },
    "content.important-game.game-rain.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "After the Rain Delay" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "우천 중단 뒤" } }
      }
    },
    "content.important-game.game-rain.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The game stopped for two hours, and this is the first hitter you face after your body cools down." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "두 시간 동안 경기가 멈춰 몸이 식은 뒤 만나는 첫 타자입니다." } }
      }
    },
    "content.important-game.game-one-run.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "One-Run Game" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "한 점 차" } }
      }
    },
    "content.important-game.game-one-run.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your final high school inning before the draft." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "드래프트 전 마지막 고교 이닝" } }
      }
    },
    "content.important-game.game-new-catcher.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "First Game with a New Catcher" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "새 포수와 첫 경기" } }
      }
    },
    "content.important-game.game-new-catcher.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You and the new catcher still haven’t synced up on the pitch signs." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "새 포수와 아직 구종 사인을 충분히 맞추지 못했습니다." } }
      }
    },
    "content.important-game.game-national-final.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "National Final" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "전국 결승" } }
      }
    },
    "content.important-game.game-national-final.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Two outs, runners on first and second. One final out stands between you and the title." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "2사 1·2루. 마지막 아웃 하나에 우승이 걸렸습니다." } }
      }
    },
    "content.important-game.game-walkoff-defense.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Protecting a Ninth-Inning Lead" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "9회말 리드 방어" } }
      }
    },
    "content.important-game.game-walkoff-defense.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Bottom of the ninth, one out, runners on second and third, up by one. A fly ball ties it; a hit ends the game." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "한 점 앞선 9회말 1사 2·3루. 외야로 뜨기만 해도 동점, 안타면 경기가 끝납니다." } }
      }
    },
    "content.important-game.game-extra-tiebreak.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Extra-Inning Tiebreaker" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "연장 승부치기" } }
      }
    },
    "content.important-game.game-extra-tiebreak.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Extra-inning tiebreaker. Runners start on first and second with no outs. Fail to get an out, and this inning can snowball." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "연장 승부치기. 무사 1·2루에서 시작합니다. 아웃부터 잡지 못하면 큰 이닝이 됩니다." } }
      }
    },
    "content.important-game.game-ace-duel.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "0–0 Pitcher’s Duel" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "0-0 투수전" } }
      }
    },
    "content.important-game.game-ace-duel.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A scoreless game through eight. Their ace isn’t blinking. The first mistake loses it." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "8회까지 0의 행진. 상대 에이스도 지지 않습니다. 먼저 실수하는 쪽이 집니다." } }
      }
    },
    "content.important-game.game-damage-control.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Stopping the Damage" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "실점 뒤 수습" } }
      }
    },
    "content.important-game.game-damage-control.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Three runs scored this inning to tie the game. The bases are loaded again. Give up more here, and the game swings away." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 이닝에만 석 점을 내줘 동점이 됐습니다. 다시 만루. 여기서 더 내주면 경기가 넘어갑니다." } }
      }
    },
    "content.important-game.game-rain-grip.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Rain-Slick Ball" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "빗속의 공" } }
      }
    },
    "content.important-game.game-rain-grip.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The wet ball keeps slipping from your fingertips. Every pitch misses the target by a few inches." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "빗물을 머금은 공이 손끝에서 자꾸 미끄러집니다. 노린 코스보다 한 뼘씩 벗어납니다." } }
      }
    },
    "content.important-game.game-doubleheader.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Doubleheader, Game Two" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "더블헤더 2차전" } }
      }
    },
    "content.important-game.game-doubleheader.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The second game of the day. You’re down a run, and the arm you used earlier still feels heavy." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "오늘 두 번째 경기. 한 점 뒤진 채, 낮 경기에서 이미 던진 팔이 무겁게 남아 있습니다." } }
      }
    },
    "content.important-game.game-scout-showcase.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Scouts Everywhere" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "스카우트 총출동" } }
      }
    },
    "content.important-game.game-scout-showcase.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your team is down two, but the first row is packed with scouts. Every pitch goes into their notes." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "팀은 두 점 뒤졌지만 관중석 첫 줄은 스카우트로 가득합니다. 공 하나하나가 순위표에 적힙니다." } }
      }
    },
    "content.important-game.game-rival-away.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Rival School Road Game" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "라이벌 원정" } }
      }
    },
    "content.important-game.game-rival-away.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "On the road at the rival school, down a run in the sixth. The stands drown the mound in boos. You have to erase the noise to see the ball." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "라이벌 학교 원정, 한 점 뒤진 6회. 마운드에 설 때마다 스탠드가 야유로 덮습니다. 소리를 지워야 공이 보입니다." } }
      }
    },
    "content.important-game.game-cold-spring.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Early-Spring Fingers" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이른 봄의 손끝" } }
      }
    },
    "content.important-game.game-cold-spring.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The first tournament in March. Your breath hangs in the air, the ball feels like a stone, and half the feel in your fingertips is still asleep." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "3월의 첫 대회. 입김이 보이는 추위에 공이 돌덩이처럼 미끄럽고, 손끝의 감각이 절반만 돌아와 있습니다." } }
      }
    },
    "content.important-game.game-fireman.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Inherited Runners" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "떠안은 주자" } }
      }
    },
    "content.important-game.game-fireman.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You take over with nobody out and runners on second and third. The runs aren’t charged to you, but the game is now in your hands." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "앞선 투수가 남긴 무사 2·3루를 떠안고 오릅니다. 여기서 들어오는 점수는 내 기록이 아니지만, 경기는 내 손에 있습니다." } }
      }
    },
    "content.important-game.game-mercy-watch.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Five-Run Trap" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다섯 점의 함정" } }
      }
    },
    "content.important-game.game-mercy-watch.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A five-run lead. That’s exactly when the game starts slipping as focus fades. The scout is watching how you handle a big lead." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다섯 점 리드. 긴장이 풀리는 딱 그 지점에서 실점이 시작됩니다. 스카우트는 큰 리드에서의 집중력을 봅니다." } }
      }
    },
    "content.important-game.game-nightfall.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Before Sundown" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "일몰 직전" } }
      }
    },
    "content.important-game.game-nightfall.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "There are no lights at this field, and the sun is dropping behind the mountain. The umpire says this inning is the last today. If it’s tied, you start over tomorrow." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "조명 없는 구장, 해가 산 뒤로 넘어가고 있습니다. 심판이 이 이닝이 오늘의 마지막이라고 알렸습니다. 동점이면 내일 처음부터 다시입니다." } }
      }
    },
    "content.important-game.game-heatwave.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Midsummer Day Game" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "한여름 낮 경기" } }
      }
    },
    "content.important-game.game-heatwave.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A 95°F day game. Your uniform clings, and even the rosin bag is damp. A one-run lead feels eight outs away in the heat." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "35도의 낮 경기. 유니폼이 몸에 감기고 로진백도 눅눅합니다. 한 점 리드가 이 더위 속에서 여덟 아웃만큼 멀어 보입니다." } }
      }
    },
    "content.important-game.game-third-look.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Third Look at the Cleanup Hitter" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "세 번째 만나는 4번" } }
      }
    },
    "content.important-game.game-third-look.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You face their cleanup hitter for the third time today. They remember every pitch from the first two plate appearances. The same sequence won’t work now." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "오늘 세 번째로 만나는 상대 4번 타자. 앞선 두 타석의 공을 전부 기억하고 있을 겁니다. 같은 순서는 이제 통하지 않습니다." } }
      }
    },
    "content.important-game.game-perfect-bid.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Perfect Through Five" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "5회까지 완전" } }
      }
    },
    "content.important-game.game-perfect-bid.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No one has reached base through five. The dugout has gone quiet—no one wants to say it out loud." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "5회까지 한 명도 내보내지 않았습니다. 더그아웃이 조용해졌습니다 — 아무도 그 단어를 입에 올리지 않습니다." } }
      }
    },
    "content.important-game.game-backup-catcher.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "With the Backup Catcher" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "백업 포수와의 승부" } }
      }
    },
    "content.important-game.game-backup-catcher.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The starting catcher left after taking a foul ball off a finger. You’ve only worked with the backup once in the bullpen." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "주전 포수가 파울 타구에 손가락을 맞아 교체됐습니다. 백업 포수와는 불펜 한 번 맞춰 본 게 전부입니다." } }
      }
    },
    "content.important-game.game-seniors-last.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Seniors’ Last Game" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "선배들의 마지막" } }
      }
    },
    "content.important-game.game-seniors-last.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Down two in the eighth. If you lose, the third-year players’ high school careers end today. Every eye in the dugout is on the mound." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "두 점 뒤진 8회. 지면 3학년 선배들의 고교 야구가 오늘로 끝납니다. 더그아웃의 눈이 전부 마운드를 보고 있습니다." } }
      }
    },
    "content.important-game.game-sign-leak.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Leaking Signs" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "새는 사인" } }
      }
    },
    "content.important-game.game-sign-leak.narrative" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The runner on second appears to be tipping something to the hitter. If they’ve cracked the signs, this is a test of nerve more than location." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "상대 2루 주자가 타자에게 무언가를 전달하는 정황. 사인이 읽히고 있다면, 이제부터는 코스보다 배짱의 승부입니다." } }
      }
    },
    "content.chapter-goal.catcher-bet.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The catcher grinned while packing the gear. Want to bet on %lld strikeouts this stretch?" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "포수가 장비를 챙기며 웃었다 — 이번 이야기 삼진 %lld개, 내기할까?" } }
      }
    },
    "content.chapter-goal.catcher-bet.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Catcher's Bet" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "포수의 내기" } }
      }
    },
    "content.chapter-goal.coach-assignment.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The coach mentioned it in passing: try to record %lld strikeouts this stretch." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "감독이 지나가듯 말했다 — 이번 이야기에 삼진 %lld개는 잡아 보라고." } }
      }
    },
    "content.chapter-goal.coach-assignment.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Coach's Assignment" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "감독의 숙제" } }
      }
    },
    "content.chapter-goal.personal-promise.detail" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "One line before lights-out: %lld strikeouts this stretch." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "소등 전에 적어 둔 한 줄 — 이번 이야기, 삼진 %lld개." } }
      }
