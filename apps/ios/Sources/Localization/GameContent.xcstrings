    "content.community-buzz.reaction.nickname-question" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Have you seen everyone calling him \"%@\" now? I hate to admit it, but it fits." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "'%@' 별명 붙은 거 봤음? 인정할 수밖에 없긴 함" } }
      }
    },
    "content.community-buzz.reaction.nickname-calling" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Everyone's calling him \"%@\" these days. That name really stuck." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "요즘 다들 '%@' 하고 부르던데 찰떡이긴 하다" } }
      }
    },
    "content.community-buzz.reaction.nickname-high-school-real" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A high school player getting a nickname like \"%@\" means he's for real." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "별명이 '%@'... 고교야구에서 별명 생기면 진짜라는 뜻임" } }
      }
    },
    "content.community-buzz.reaction.dominant-shutout-never-saw-it" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "I watched today in person. The hitters never even saw the ball." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "오늘 경기 직관했는데 상대 타자들이 공을 아예 못 봄" } }
      }
    },
    "content.community-buzz.reaction.dominant-shutout-level" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A scoreless game with %lld strikeouts? That's beyond high school level." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "무실점에 탈삼진 %lld개면 고교 레벨이 아닌 듯" } }
      }
    },
    "content.community-buzz.reaction.dominant-shutout-age" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "He throws like that at his age? What happens when he fills out?" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저 나이에 저런 공을 던진다고? 더 크면 어떻게 되는 거임?" } }
      }
    },
    "content.community-buzz.reaction.dominant-shutout-scouts" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Wonder what the scouts wrote in their notebooks today." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "스카우트들 오늘 수첩에 뭐라고 적었을지 궁금하다" } }
      }
    },
    "content.community-buzz.reaction.shutout-quiet" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Not flashy, but he never gave them a run. That's the scary kind of pitcher." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "화려하진 않은데 점수를 안 줌. 이런 투수가 무서운 거임" } }
      }
    },
    "content.community-buzz.reaction.shutout-consistent" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Scoreless again. Quiet consistency is the hardest thing to build." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "오늘도 무실점. 조용히 꾸준한 게 제일 어려운 건데" } }
      }
    },
    "content.community-buzz.reaction.shutout-stands" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You could see the other dugout go quiet." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "상대 팀 응원석이 조용해지는 게 보이더라" } }
      }
    },
    "content.community-buzz.reaction.wildness-walks" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The stuff is there, but %lld walks is a problem. Command is the whole question now." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "공은 좋은데 볼넷 %lld개는 좀... 제구 잡히는 게 관건일 듯" } }
      }
    },
    "content.community-buzz.reaction.wildness-frustrated" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Too many walks today. He must have been the most frustrated person out there." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "오늘 볼넷이 너무 많았음. 본인이 제일 답답했을 듯" } }
      }
    },
    "content.community-buzz.reaction.wildness-stuff" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The stuff is real. Not knowing where it goes is the catch." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "구위는 진짜인데 어디로 갈지 모르는 게 함정" } }
      }
    },
    "content.community-buzz.reaction.rough-outing-misses" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Everything leaked back over the plate today. Some days are like that." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "오늘은 공이 다 몰리더라. 이런 날도 있는 거지" } }
      }
    },
    "content.community-buzz.reaction.rough-outing-next-test" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld runs allowed... The real test is how he answers next time out." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%lld실점... 다음 경기에서 어떻게 나오는지가 진짜 시험임" } }
      }
    },
    "content.community-buzz.reaction.rough-outing-watch" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "What comes after a collapse is the part I want to see. I'm watching." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "무너진 날 다음이 진짜라고 생각함. 지켜본다" } }
      }
    },
    "content.community-buzz.reaction.strikeout-show" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld strikeouts, wow. Once he got to two strikes, every at-bat felt over." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "탈삼진 %lld개 ㅎㄷㄷ 2스트라이크 잡히면 끝나는 분위기였음" } }
      }
    },
    "content.community-buzz.reaction.strikeout-pitch" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The swings looked different against him. What kind of pitch was that?" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "헛스윙 나오는 각도가 다르던데 저거 무슨 공임?" } }
      }
    },
    "content.community-buzz.reaction.strikeout-rhythm" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "His strikeout rhythm has changed. He looks like a completely different pitcher from last year." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "삼진 잡는 리듬이 좋아졌음. 작년이랑 완전 다른 선수 같음" } }
      }
    },
    "content.community-buzz.reaction.general-grade" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "What grade is he in? He looks built to pitch." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저 선수 몇 학년임? 체격 좋아 보이던데" } }
      }
    },
    "content.community-buzz.reaction.general-next-game" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "When's his next game? I want to see him in person." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "다음 경기 언제임? 직관 가고 싶은데" } }
      }
    },
    "content.community-buzz.reaction.general-training" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "What kind of training produces a pitcher like that?" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "훈련을 어떻게 하길래 저렇게 던짐?" } }
      }
    },
    "content.community-buzz.reaction.general-pro" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Is he thinking about going pro? I'm curious already." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "프로 갈 생각 있는 선수임? 벌써 궁금하네" } }
      }
    },
    "content.community-buzz.reaction.general-off-field" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "What is he like away from the field?" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "경기 밖에서는 어떤 스타일인지 궁금함" } }
      }
    },
    "content.community-buzz.reaction.general-health" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Hope he stays healthy. Someone must be managing his workload, right?" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "부상 없이 쭉 갔으면 좋겠다. 관리 잘 받고 있겠지?" } }
      }
    },
    "content.community-buzz.reaction.general-last-year" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Was he this good last year? He suddenly looks like a different player." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "작년에도 이 정도였음? 갑자기 좋아진 것 같은데" } }
      }
    },
    "content.community-buzz.reaction.general-school" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Why did that school suddenly get so strong?" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "저 학교 갑자기 왜 이렇게 강해짐?" } }
      }
    },
    "content.community-buzz.rival-news.regional-final-shutout" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ (%@) threw a complete-game shutout in the regional tournament final. Word is the scout seats were packed." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@(%@)이 지역 대회 결승에서 완봉승. 스카우트석이 가득 찼다는 후문." } }
      }
    },
    "content.community-buzz.rival-news.elbow-pain" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ (%@) missed his start with elbow pain. Some call it a management failure; others say caution is the right call." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@(%@), 팔꿈치 통증으로 등판을 걸렀다. 관리 실패라는 말과 신중하다는 말이 갈린다." } }
      }
    },
    "content.community-buzz.rival-news.strikeout-record" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ (%@) struck out %lld in one game — closing in on the best mark among his peers." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@(%@)이 한 경기 탈삼진 %lld개 — 또래 최고 기록에 다가섰다." } }
      }
    },
    "content.community-buzz.rival-news.velocity-gain" : {
      "localizations" : {
