      }
    },
    "content.training-result.detail.growth-recovery" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ rating increased by %lld. Fatigue dropped by %lld." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%@ 능력치가 %lld 올랐습니다. 피로도 %lld 줄었습니다." } }
      }
    },
    "content.training-result.detail.no-growth" : {
