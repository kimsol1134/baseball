    "content.event.evt-national-stage.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Broadcast cameras follow you from the bullpen before the game." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "경기 전 불펜부터 중계 카메라가 계속 따라붙습니다." } }
