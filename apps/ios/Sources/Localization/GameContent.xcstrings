        "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld straight scoreless games — not a run allowed yet." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "%lld경기째 무실점 — 아직 한 점도 내주지 않았습니다." } }
