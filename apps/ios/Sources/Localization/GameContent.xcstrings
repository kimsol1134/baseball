        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your top velocity is down 1.2 mph in back-to-back games." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "두 경기 연속 최고 구속이 2km/h 낮게 찍혔습니다." } }
