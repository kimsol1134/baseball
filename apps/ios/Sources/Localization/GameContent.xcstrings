    "content.event.evt-catcher-doubt.summary" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your catcher asks why you keep shaking off his signs." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "포수가 최근 자신의 사인을 자주 거절하는 이유를 묻습니다." } }
      }
    },
    "content.event.evt-coach-last-advice.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Coach's Last Advice" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "감독의 마지막 조언" } }
