        "en" : { "stringUnit" : { "state" : "translated", "value" : "No rating moved this session. Adjust fatigue and intensity, then try again." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이번 훈련에서는 능력치가 오르지 않았습니다. 피로와 훈련 강도를 조절해 다시 시도할 수 있습니다." } }
      }
    },
    "content.training-result.detail.rehab" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Rehab restores your arm. This session adds no rating growth." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "재활 훈련으로 팔 상태를 회복합니다. 이번 훈련은 성장 없이 지나갑니다." } }
      }
    },
    "content.training-result.detail.jackpot" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Huge breakthrough—the day opened up for you. %@" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "대성공! 오늘은 몸이 완전히 열렸습니다. %@" } }
      }
    },
    "content.training-result.detail.recovery" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Ratings held steady, but fatigue dropped by %lld." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "능력치는 그대로지만 피로가 %lld 줄었습니다." } }
