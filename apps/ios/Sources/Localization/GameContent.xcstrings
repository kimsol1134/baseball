        "en" : { "stringUnit" : { "state" : "translated", "value" : "After the Rain Delay" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "비가 멈춘 뒤" } }
      }
    },
    "content.event.evt-rain-delay.summary" : {
