    "content.relationship.evt-arm-care.choice.explain.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Get a precise exam" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "정밀 검진" } }
