{
  "name": "baseball",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/windows",
    "apps/landing"
  ],
  "scripts": {
    "landing:dev": "npm run dev --workspace @baseball/landing",
    "landing:build": "npm run build --workspace @baseball/landing",
    "landing:typecheck": "npm run typecheck --workspace @baseball/landing",
    "build:swift": "swift build --package-path packages/simulation-core",
    "test:swift": "swift test --package-path packages/simulation-core",
    "test:web": "npm run test --workspace @baseball/windows",
    "test:e2e": "npm run test:e2e --workspace @baseball/windows",
    "build:web": "npm run build --workspace @baseball/windows",
    "check:web-assets": "node tools/check-web-assets.mjs",
    "check:design-system": "node tools/check-design-system.mjs",
    "check:copy": "node tools/check-copy.mjs",
    "check:copy:android:unity": "node tools/check-copy.mjs --android-unity",
    "check:dialogue-parity": "node tools/check-dialogue-parity.mjs",
    "check:korean-copy": "node tools/check-korean-game-copy.mjs",
    "check:korean-copy:ci": "node tools/check-korean-game-copy.mjs --fail-on-warnings",
    "test:korean-copy": "node --test tools/tests/korean-copy.test.mjs",
    "inventory:ios-localization": "node tools/inventory-ios-localization.mjs",
    "check:ios-localization": "node tools/check-ios-localization.mjs",
    "check:unity-assets": "node tools/check-unity-assets.mjs",
    "check:android:unity": "node tools/check-android-unity-release.mjs",
    "test:unity": "bash tools/unity-android-test.sh",
    "test:unity:static": "dotnet test tools/unity-static-tests/Baseball.UnityStatic.Tests.csproj --configuration Release --nologo",
    "test:unity:references": "bash tools/unity-reference-compile.sh",
    "smoke:android:unity": "bash tools/android-unity-smoke/run.sh",
    "test:android:compose": "bash tools/android-compose-test.sh",
    "test:android:compose:unit": "bash tools/android-compose-test.sh",
    "test:android:compose:instrumentation": "bash tools/android-compose-instrumentation.sh",
    "export:android:pitch-unity": "bash tools/export-android-pitch-unity.sh",
    "build:android:compose:verify": "bash tools/android-compose-build.sh verification",
    "build:android:compose:rc": "bash tools/android-compose-build.sh rc",
    "check:android:compose:release": "node tools/check-android-compose-release.mjs",
    "report:android:fixtures": "npm run export:android:swift-fixture && npm run export:android:swift-phase4-fixture && npm run export:android:swift-pro-fixture && node tools/android-compose-fixture-report.mjs && dotnet run --project tools/pitch-fixture-compare/PitchFixtureCompare.csproj --configuration Release",
    "export:android:swift-fixture": "BASEBALL_PITCH_ORACLE_OUTPUT=artifacts/android-compose/fixtures/swift-pitch-kernel-oracle-v1.json swift run --package-path packages/simulation-core pitch-oracle-fixture-exporter",
    "export:android:swift-phase4-fixture": "BASEBALL_HIGH_SCHOOL_PHASE4_ORACLE_OUTPUT=artifacts/android-compose/fixtures/swift-high-school-phase4-oracle-v3.json swift run --package-path packages/simulation-core high-school-phase4-fixture-exporter",
    "export:android:swift-pro-fixture": "BASEBALL_PRO_ORACLE_OUTPUT=artifacts/android-compose/fixtures/swift-pro-career-oracle-v1.json swift run --package-path packages/simulation-core pro-career-fixture-exporter",
    "export:android:swift-pro-fixture:v2": "BASEBALL_PRO_ORACLE_V2_OUTPUT=apps/android/game-core/src/test/resources/fixtures/swift-pro-career-oracle-v2.json swift run --package-path packages/simulation-core --build-path .build/pro-career-depth-swift pro-career-fixture-exporter-v2",
    "run:pro-career:distribution:smoke": "swift build -c release --package-path packages/simulation-core --build-path .build/pro-career-depth-swift --product pro-career-distribution-runner && BASEBALL_PRO_DISTRIBUTION_SEEDS=8 BASEBALL_PRO_DISTRIBUTION_SEASONS=20 BASEBALL_PRO_DISTRIBUTION_OUTPUT=artifacts/analysis/pro-career-wave6/swift-distribution-smoke.json .build/pro-career-depth-swift/release/pro-career-distribution-runner",
    "run:pro-career:distribution:smoke:60x20": "swift build -c release --package-path packages/simulation-core --build-path .build/pro-career-depth-swift --product pro-career-distribution-runner && BASEBALL_PRO_DISTRIBUTION_SEEDS=60 BASEBALL_PRO_DISTRIBUTION_SEASONS=20 BASEBALL_PRO_DISTRIBUTION_OUTPUT=artifacts/analysis/pro-career-wave6/swift-distribution-smoke-60x20.json .build/pro-career-depth-swift/release/pro-career-distribution-runner",
    "run:pro-career:distribution:smoke:20x20": "swift build -c release --package-path packages/simulation-core --build-path .build/pro-career-depth-swift --product pro-career-distribution-runner && BASEBALL_PRO_DISTRIBUTION_SEEDS=20 BASEBALL_PRO_DISTRIBUTION_SEASONS=20 BASEBALL_PRO_DISTRIBUTION_OUTPUT=artifacts/analysis/pro-career-wave6/swift-distribution-20x20.json .build/pro-career-depth-swift/release/pro-career-distribution-runner",
    "run:pro-career:distribution:release": "swift build -c release --package-path packages/simulation-core --build-path .build/pro-career-depth-swift --product pro-career-distribution-runner && BASEBALL_PRO_DISTRIBUTION_OUTPUT=artifacts/analysis/pro-career-wave6/swift-distribution-1000x20.json .build/pro-career-depth-swift/release/pro-career-distribution-runner --release",
    "run:android:pro-career:distribution:smoke": "cd apps/android && ./gradlew :game-core:runProCareerDistribution --no-daemon",
    "run:android:pro-career:distribution:release": "cd apps/android && ./gradlew :game-core:runProCareerDistribution -PproCareerRelease=true --no-daemon",
  "check:android:compose": "node tools/check-android-compose.mjs",
  "check:android:phase9": "node tools/check-android-phase9.mjs",
    "baseline:android:compose": "node tools/capture-android-compose-baseline.mjs",
    "build:android:compose": "bash tools/build-android-compose.sh",
    "smoke:android:compose": "bash tools/android-compose-emulator-smoke.sh",
    "build:android:verify": "BASEBALL_BUILD_MODE=verification bash tools/unity-android-build.sh",
    "build:android:rc": "BASEBALL_BUILD_MODE=rc bash tools/unity-android-build.sh",
    "prepare:sidecar": "node tools/build-sidecar.mjs",
    "smoke:sidecar": "node tools/smoke-sidecar.mjs",
    "check:tauri": "node tools/run-cargo.mjs check --manifest-path apps/windows/src-tauri/Cargo.toml",
    "desktop:dev": "npm run prepare:sidecar && node tools/run-tauri.mjs dev",
    "desktop:build": "npm run prepare:sidecar && node tools/run-tauri.mjs build",
    "desktop:build:mac": "npm run prepare:sidecar && node tools/run-tauri.mjs build --bundles app,dmg",
    "desktop:build:windows": "npm run prepare:sidecar && node tools/run-tauri.mjs build --bundles nsis,msi",
    "steam:build:full": "node tools/build-steam-depot.mjs full",
    "steam:build:demo": "node tools/build-steam-depot.mjs demo",
    "steam:smoke": "node tools/smoke-steam-depot.mjs",
    "steam:config:full": "node tools/generate-steamworks-config.mjs full",
    "steam:config:demo": "node tools/generate-steamworks-config.mjs demo",
    "steam:submission:check": "node tools/check-steam-submission.mjs",
    "test:tauri": "node tools/run-cargo.mjs test --manifest-path apps/windows/src-tauri/Cargo.toml",
    "check": "npm run check:design-system && npm run check:copy && npm run check:balance && npm run test:swift && npm run test:web && npm run build:web && npm run test:tauri && npm run check:tauri",
  "check:pro-career": "node tools/check-pro-career.mjs",
  "check:pro-career:wave5": "node tools/check-pro-career-wave5.mjs",
  "check:balance": "node tools/check-balance.mjs",
    "check:web-assets:desktop": "node tools/check-web-assets.mjs --profile desktop"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
